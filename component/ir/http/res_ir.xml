<?xml version='1.0' encoding='UTF-8' standalone='yes'?>
<ir>
  <message name="HTTP_Response">
    <!-- HTTP response message consisting of status line, optional headers, an empty line, and an optional body -->

    <field name="ProtocolName" type="constant" length="4B" value="HTTP"/>
    <!-- Literal "HTTP" indicating the protocol -->

    <field name="Slash" type="constant" length="1B" value="0x2F"/>
    <!-- Forward slash separating "HTTP" from the version numbers -->

    <field name="MajorVersion" type="variable" length="undefined" value="1*DIGIT"/>
    <!-- Major version number of the HTTP protocol (e.g., 1) -->

    <field name="Dot" type="constant" length="1B" value="0x2E"/>
    <!-- Dot separating major and minor version numbers -->

    <field name="MinorVersion" type="variable" length="undefined" value="1*DIGIT"/>
    <!-- Minor version number (e.g., 1) -->

    <field name="Space1" type="constant" length="1B" value="0x20"/>
    <!-- Space between version and status code -->

    <field name="StatusCode" type="variable" length="3B" value="3DIGIT"/>
    <!-- Three-digit status code indicating the result of the request (e.g., 200, 404) -->

    <field name="Space2" type="constant" length="1B" value="0x20"/>
    <!-- Space between status code and reason phrase -->

    <field name="ReasonPhrase" type="variable" length="undefined" value="*TEXT (any OCTET except CTLs, but including LWS)"/>
    <!-- Short textual description of the status code (e.g., OK, Not Found) -->

    <field name="StatusLineCRLF" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed ending the status line -->

    <field name="HeaderSection" type="variable" length="undefined" value="*(field-name ':' OWS field-value OWS CRLF) CRLF"/>
    <!-- Zero or more header fields (each followed by CRLF) and a terminating empty line (CRLF).
         Field names and values follow HTTP header syntax (RFC 9110). OWS = optional whitespace. -->

    <field name="MessageBody" type="variable" length="undefined" value="arbitrary octets"/>
    <!-- Body of the response, if present. Length is determined by Content-Length header or chunked transfer encoding. -->
</message>
</ir>
