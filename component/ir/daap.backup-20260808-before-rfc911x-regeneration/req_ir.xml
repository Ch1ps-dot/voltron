<?xml version='1.0' encoding='UTF-8' standalone='yes'?>
<ir>
  <message name="/databases/[num]/containers">
    <!-- Request to retrieve all playlists (containers) from a DAAP database -->

    <field name="HTTPMethod" type="constant" length="3B" value="GET"/>
    <!-- HTTP GET is used for this DAAP request -->

    <field name="MethodSeparator" type="constant" length="1B" value="0x20"/>
    <!-- Single space separating the HTTP method from the request target -->

    <field name="DatabaseCollectionPath" type="constant" length="11B" value="/databases/"/>
    <!-- Fixed path prefix selecting the database collection -->

    <field name="DatabaseID" type="variable" length="undefined" value="0x30-0x39 (one or more ASCII decimal digits)"/>
    <!-- Replaces the [num] placeholder with the numeric database identifier -->

    <field name="ContainerCollectionPath" type="constant" length="11B" value="/containers"/>
    <!-- Fixed path suffix selecting the playlist/container collection -->

    <field name="TargetSeparator" type="constant" length="1B" value="0x20"/>
    <!-- Single space between the request target and the HTTP version -->

    <field name="HTTPVersion" type="constant" length="8B" value="HTTP/1.1"/>
    <!-- HTTP version used by DAAP requests -->

    <field name="RequestLineEnd" type="constant" length="2B" value="0x0D0A"/>
    <!-- CRLF ending the HTTP request line -->

    <field name="ClientDAAPVersionName" type="constant" length="19B" value="Client-DAAP-Version"/>
    <!-- DAAP-specific header name identifying the client protocol version -->

    <field name="HeaderSeparator" type="constant" length="2B" value="0x3A20"/>
    <!-- Colon and space separating the header name from its value -->

    <field name="ClientProtocolVersion" type="constant" length="3B" value="1.0"/>
    <!-- DAAP protocol version sent by iTunes; value is 1.0 -->

    <field name="HeaderLineEnd" type="constant" length="2B" value="0x0D0A"/>
    <!-- CRLF ending the Client-DAAP-Version header line -->

    <field name="EndOfHeaders" type="constant" length="2B" value="0x0D0A"/>
    <!-- Blank line terminating the HTTP header section; this GET request has no body -->
</message>
  <message name="/resolve">
    <!-- DAAP /resolve command: an HTTP GET request used to obtain a direct playback link to a DAAP resource or playlist. Detailed response semantics are not fully specified in the source excerpt. -->
    <!-- Transport: TCP port 3689. Responses are application/x-dmap-tagged and may be gzip-encoded. This definition models the request message. -->

    <field name="Method" type="constant" length="3B" value="GET"/>
    <!-- HTTP method; DAAP requests are always HTTP GET requests. -->

    <field name="SpaceAfterMethod" type="constant" length="1B" value="0x20"/>
    <!-- Single space separating the HTTP method from the request-target. -->

    <field name="RequestTarget" type="constant" length="8B" value="/resolve"/>
    <!-- Request-URI path for this DAAP command. No query string is defined by the available protocol description. -->

    <field name="SpaceAfterTarget" type="constant" length="1B" value="0x20"/>
    <!-- Single space separating the request-target from the HTTP version. -->

    <field name="HTTPVersion" type="constant" length="8B" value="HTTP/1.1"/>
    <!-- HTTP protocol version token used by the DAAP server. -->

    <field name="RequestLineEnd" type="constant" length="2B" value="0x0D0A"/>
    <!-- CRLF line terminator ending the HTTP request line. -->

    <field name="HostHeaderName" type="constant" length="5B" value="Host:"/>
    <!-- HTTP Host header name; required in HTTP/1.1 requests. -->

    <field name="HostHeaderValueStart" type="constant" length="1B" value="0x20"/>
    <!-- Space between the Host header name and its value. -->

    <field name="HostValue" type="variable" length="undefined" value="hostname or IP address, optionally with port"/>
    <!-- Target server host identifier; actual length depends on the server address. -->

    <field name="HostHeaderEnd" type="constant" length="2B" value="0x0D0A"/>
    <!-- CRLF line terminator ending the Host header. -->

    <field name="AcceptHeaderName" type="constant" length="7B" value="Accept:"/>
    <!-- Accept header name from the sample DAAP request. HTTP header order is not semantically significant. -->

    <field name="AcceptHeaderValueStart" type="constant" length="1B" value="0x20"/>
    <!-- Space between the Accept header name and its value. -->

    <field name="AcceptValue" type="constant" length="3B" value="*/*"/>
    <!-- Accept-All MIME type as shown in the DAAP sample request. -->

    <field name="AcceptHeaderEnd" type="constant" length="2B" value="0x0D0A"/>
    <!-- CRLF line terminator ending the Accept header. -->

    <field name="UserAgentHeaderName" type="constant" length="11B" value="User-Agent:"/>
    <!-- User-Agent header name from the sample DAAP request. This header is client-specific and may vary. -->

    <field name="UserAgentHeaderValueStart" type="constant" length="1B" value="0x20"/>
    <!-- Space between the User-Agent header name and its value. -->

    <field name="UserAgentValue" type="variable" length="undefined" value="printable ASCII string identifying client software"/>
    <!-- Client software identifier; the sample value is iTunes/4.0 (Macintosh; N; PPC). Exact value is not fixed by the protocol. -->

    <field name="UserAgentHeaderEnd" type="constant" length="2B" value="0x0D0A"/>
    <!-- CRLF line terminator ending the User-Agent header. -->

    <field name="ClientDAAPVersionHeaderName" type="constant" length="20B" value="Client-DAAP-Version:"/>
    <!-- DAAP-specific version header; this is the extra DAAP header described in the protocol summary. -->

    <field name="ClientDAAPVersionHeaderValueStart" type="constant" length="1B" value="0x20"/>
    <!-- Space between the Client-DAAP-Version header name and its value. -->

    <field name="ClientDAAPVersionValue" type="constant" length="3B" value="1.0"/>
    <!-- DAAP protocol version sent by iTunes. This header may be omitted by non-iTunes clients; the server accepts requests without it. -->

    <field name="ClientDAAPVersionHeaderEnd" type="constant" length="2B" value="0x0D0A"/>
    <!-- CRLF line terminator ending the Client-DAAP-Version header. -->

    <field name="AcceptEncodingHeaderName" type="constant" length="16B" value="Accept-Encoding:"/>
    <!-- Accept-Encoding header name; used to request gzip content encoding. -->

    <field name="AcceptEncodingHeaderValueStart" type="constant" length="1B" value="0x20"/>
    <!-- Space between the Accept-Encoding header name and its value. -->

    <field name="AcceptEncodingValue" type="constant" length="4B" value="gzip"/>
    <!-- Requested content coding. The server may also send uncompressed data when this header is absent or ignored. -->

    <field name="AcceptEncodingHeaderEnd" type="constant" length="2B" value="0x0D0A"/>
    <!-- CRLF line terminator ending the Accept-Encoding header. -->

    <field name="HeaderSectionEnd" type="constant" length="2B" value="0x0D0A"/>
    <!-- Final empty line marking the end of the HTTP request headers. The /resolve request has no defined body. -->
</message>
  <message name="/server-info">
    <!-- Response body returned by a GET /server-info request. The root DMAP container is 'msrv' (dmap.serverinforesponse); the fields below are its children. DMAP values are TLV items: a 4-character tag, a 4-byte big-endian length, and the value. Integer values and lengths are big-endian. The body may be gzip-compressed at the HTTP layer; this syntax describes the uncompressed DMAP payload. -->

    <field name="dmap.status" type="variable" length="4B" value="0..4294967295"/>
    <!-- DMAP tag 'mstt': response status code. Normally 200 (0x000000C8) for a successful server-info response; other values indicate errors. -->

    <field name="dmap.protocolversion" type="constant" length="3B" value="1.0"/>
    <!-- DMAP tag 'mpro': version of the DMAP protocol. The sample response encodes this as "1.0"; the surrounding description writes the version as 1.0.0. -->

    <field name="daap.protocolversion" type="constant" length="3B" value="1.0"/>
    <!-- DMAP tag 'apro': version of the DAAP protocol. The sample response encodes this as "1.0"; the surrounding description writes the version as 1.0.0. -->

    <field name="dmap.itemname" type="variable" length="undefined" value="UTF-8 or ASCII printable string"/>
    <!-- DMAP tag 'minm': server name presented to clients. The DMAP TLV length field gives the exact string length. -->

    <field name="dmap.loginrequired" type="variable" length="1B" value="0 or 1"/>
    <!-- DMAP tag 'mslr': optional flag. If present and nonzero, the client must log in before running queries. Sample value is 0. -->

    <field name="dmap.timeoutinterval" type="variable" length="4B" value="0..4294967295"/>
    <!-- DMAP tag 'mstm': connection timeout interval in seconds. Sample value is 1800. -->

    <field name="dmap.supportsautologout" type="variable" length="1B" value="0 or 1"/>
    <!-- DMAP tag 'msal': optional flag. If present and nonzero, the server can automatically log clients out. Sample value is 0. -->

    <field name="dmap.supportsupdate" type="variable" length="1B" value="0 or 1"/>
    <!-- DMAP tag 'msup': optional flag. If present and nonzero, the server supports /update. Sample value is 0. -->

    <field name="dmap.supportspersistentids" type="variable" length="1B" value="0 or 1"/>
    <!-- DMAP tag 'mspi': optional flag. If present and nonzero, the server supports persistent IDs. Sample value is 0. -->

    <field name="dmap.supportsextensions" type="variable" length="1B" value="0 or 1"/>
    <!-- DMAP tag 'msex': optional flag. If present and nonzero, the server supports extensions; the exact meaning is uncertain in the source description. Sample value is 0. -->

    <field name="dmap.supportsbrowse" type="variable" length="1B" value="0 or 1"/>
    <!-- DMAP tag 'msbr': optional flag. If present and nonzero, the server supports browse operations. Sample value is 0. -->

    <field name="dmap.supportsquery" type="variable" length="1B" value="0 or 1"/>
    <!-- DMAP tag 'msqy': optional flag. If present and nonzero, the server supports query operations. Sample value is 0. -->

    <field name="dmap.supportsindex" type="variable" length="1B" value="0 or 1"/>
    <!-- DMAP tag 'msix': optional flag. If present and nonzero, the server supports index operations. Sample value is 0. -->

    <field name="dmap.supportsresolve" type="variable" length="1B" value="0 or 1"/>
    <!-- DMAP tag 'msrs': optional flag. If present and nonzero, the server supports /resolve. Sample value is 0. -->

    <field name="dmap.databasescount" type="variable" length="4B" value="0..4294967295"/>
    <!-- DMAP tag 'msdc': number of databases known to the server. Sample value is 1. -->
</message>
  <message name="/update">
    <!-- DAAP /update response payload. The client sends an HTTP GET /update request with no body; this DMAP-tagged data is returned in the response body and contains the current library/playlist revision number. -->

    <field name="Tag" type="constant" length="4B" value="mupd"/>
    <!-- DMAP content code for an update-revision record. The ASCII code "mupd" is sent as four bytes. This tag is inferred from the standard DAAP/DMAP tagged-data format. -->

    <field name="Length" type="constant" length="4B" value="0x00000004"/>
    <!-- Big-endian unsigned 32-bit length of the following RevisionNumber field. It is fixed to 4 because the revision number is encoded as a 32-bit integer. -->

    <field name="RevisionNumber" type="variable" length="4B" value="0x00000000-0xFFFFFFFF"/>
    <!-- Current revision number of the server library and playlists. The client stores this value and compares it on later /update requests to determine whether its cached data has changed. -->
</message>
  <message name="/content-codes">
    <!-- DAAP /content-codes response body, returned by the server for the Content Codes Request
         (GET /content-codes HTTP/1.1, with standard HTTP headers plus Client-DAAP-Version: 1.0).
         The payload is an application/x-dmap-tagged message that enumerates every content code
         (four-character chunk type) used by the server, along with its long name and data type,
         allowing clients to decode unknown chunks and the server to extend the protocol.
         The HTTP response body may be gzip-compressed; this syntax describes the uncompressed payload. -->

    <!-- DMAP chunk framing (inferred from the application/x-dmap-tagged format): each chunk is a
         4-byte content code (four ASCII characters), followed by a 4-byte big-endian length giving
         the number of value bytes, followed by the value itself. -->

    <field name="ContentCodesResponseTag" type="constant" length="4B" value="'mccr'"/>
    <!-- Content code of dmap.contentcodesresponse, the root container of the content codes response -->

    <field name="ContentCodesResponseLength" type="variable" length="4B" value="0x00000000-0xFFFFFFFF"/>
    <!-- Big-endian length of the root container value: the combined size of the nested mstt chunk and all mdcl chunks -->

    <field name="StatusTag" type="constant" length="4B" value="'mstt'"/>
    <!-- Content code of dmap.status, the first chunk inside the root container -->

    <field name="StatusLength" type="constant" length="4B" value="0x00000004"/>
    <!-- Fixed value length of dmap.status; content code type 5 denotes a 32-bit integer -->

    <field name="StatusCode" type="variable" length="4B" value="200"/>
    <!-- Result of the request; 200 (0x000000C8) indicates success, mirroring HTTP status semantics -->

    <field name="DictionaryTag" type="constant" length="4B" value="'mdcl'"/>
    <!-- Content code of dmap.dictionary; one mdcl chunk appears for each content code known to the server -->

    <field name="DictionaryLength" type="variable" length="4B" value="0x00000000-0xFFFFFFFF"/>
    <!-- Big-endian length of this dictionary value. Depends on ContentCodesNameLength:
         total = 30 + ContentCodesNameLength (12 bytes for the mcnm chunk, 8 + name length for mcna, 10 for mcty) -->

    <field name="ContentCodesNumberTag" type="constant" length="4B" value="'mcnm'"/>
    <!-- Content code of dmap.contentcodesnumber, the first field of each dictionary -->

    <field name="ContentCodesNumberLength" type="constant" length="4B" value="0x00000004"/>
    <!-- Fixed value length of dmap.contentcodesnumber; content code type 5 denotes a 32-bit integer -->

    <field name="ContentCodesNumberValue" type="variable" length="4B" value="4 ASCII characters, e.g. 'miid'"/>
    <!-- The four-letter chunk type described by this dictionary entry, stored as a big-endian 32-bit integer.
         The protocol documentation shows it as a string for readability, but on the wire 'miid' is 0x6D696964 -->

    <field name="ContentCodesNameTag" type="constant" length="4B" value="'mcna'"/>
    <!-- Content code of dmap.contentcodesname, the second field of each dictionary -->

    <field name="ContentCodesNameLength" type="variable" length="4B" value="0x00000000-0xFFFFFFFF"/>
    <!-- Big-endian length of the name value that follows, e.g. 11 for the string "dmap.itemid" -->

    <field name="ContentCodesNameValue" type="variable" length="undefined" value="UTF-8 string, e.g. dmap.itemid"/>
    <!-- Long semantic name of the content code, such as dmap.status, daap.songartist, or com.apple.itunes.norm-volume;
         its byte length is given by the preceding ContentCodesNameLength field -->

    <field name="ContentCodesTypeTag" type="constant" length="4B" value="'mcty'"/>
    <!-- Content code of dmap.contentcodestype, the third field of each dictionary -->

    <field name="ContentCodesTypeLength" type="constant" length="4B" value="0x00000002"/>
    <!-- Fixed value length of dmap.contentcodestype; content code type 3 denotes a 16-bit integer -->

    <field name="ContentCodesTypeValue" type="variable" length="2B" value="1|3|5|7|9|10|11|12"/>
    <!-- Data type of the chunk described by this dictionary entry:
         1 = byte, 3 = 16-bit integer, 5 = 32-bit integer, 7 = 64-bit integer,
         9 = UTF-8 string, 10 = date, 11 = version, 12 = container (nested chunk list) -->

    <!-- The fields from DictionaryTag through ContentCodesTypeValue constitute one dmap.dictionary entry.
         This group repeats for every content code known to the server; the documented response contains
         more than eighty entries (miid, minm, mikd, mper, mstt, mccr, mcnm, mcna, mcty, msrv, avdb, asal, ...). -->
</message>
  <message name="/databases/[num]/containers/[num]/items">
    <!-- DAAP HTTP request returning all items in the playlist/container identified by the two [num] values. The response is an application/x-dmap-tagged binary payload. -->

    <field name="RequestMethod" type="constant" length="3B" value="GET"/>
    <!-- HTTP request method; DAAP item listings are fetched with GET. -->

    <field name="MethodSpace" type="constant" length="1B" value="0x20"/>
    <!-- Space separating the HTTP method from the request-target. -->

    <field name="DatabaseRoot" type="constant" length="11B" value="/databases/"/>
    <!-- Fixed URI prefix selecting the DAAP database hierarchy. -->

    <field name="DatabaseId" type="variable" length="undefined" value="[0-9]+"/>
    <!-- Server-assigned numeric database identifier. -->

    <field name="ContainerRoot" type="constant" length="12B" value="/containers/"/>
    <!-- Fixed URI component selecting the playlist container hierarchy. -->

    <field name="ContainerId" type="variable" length="undefined" value="[0-9]+"/>
    <!-- Server-assigned numeric playlist/container identifier. -->

    <field name="ItemsSuffix" type="constant" length="6B" value="/items"/>
    <!-- Fixed URI suffix requesting the item collection inside the selected container. -->

    <field name="TargetSpace" type="constant" length="1B" value="0x20"/>
    <!-- Space separating the request-target from the HTTP version token. -->

    <field name="HttpVersion" type="constant" length="8B" value="HTTP/1.1"/>
    <!-- HTTP protocol version used by DAAP. -->

    <field name="RequestLineEnd" type="constant" length="2B" value="0x0D0A"/>
    <!-- CRLF terminator for the HTTP request line. -->

    <field name="HostHeaderName" type="constant" length="5B" value="Host:"/>
    <!-- HTTP/1.1 Host header name. -->

    <field name="HostHeaderSpace" type="constant" length="1B" value="0x20"/>
    <!-- Space between the Host header colon and the host value. -->

    <field name="HostHeaderValue" type="variable" length="undefined" value="host name or IP address, optional port"/>
    <!-- Address of the DAAP server being queried. -->

    <field name="HostHeaderEnd" type="constant" length="2B" value="0x0D0A"/>
    <!-- CRLF terminator for the Host header. -->

    <field name="ClientDaapVersionName" type="constant" length="19B" value="Client-DAAP-Version"/>
    <!-- DAAP-specific request header name. -->

    <field name="ClientDaapVersionColon" type="constant" length="1B" value=":"/>
    <!-- Colon separating the DAAP version header name from its value. -->

    <field name="ClientDaapVersionSpace" type="constant" length="1B" value="0x20"/>
    <!-- Space between the colon and the DAAP version value. -->

    <field name="ClientDaapVersionValue" type="constant" length="3B" value="1.0"/>
    <!-- DAAP protocol version sent by iTunes; the described server accepts requests without this header. -->

    <field name="ClientDaapVersionEnd" type="constant" length="2B" value="0x0D0A"/>
    <!-- CRLF terminator for the Client-DAAP-Version header. -->

    <field name="EndOfHeaders" type="constant" length="2B" value="0x0D0A"/>
    <!-- Empty line terminating the request header section; a GET request has no request body. -->
</message>
  <message name="/logout">
    <!-- Terminates a DAAP session. Implemented as an HTTP GET request to the /logout resource. Header order shown is one valid HTTP order; HTTP header field order is not significant. -->

    <field name="Method" type="constant" length="3B" value="GET"/>
    <!-- HTTP request method used by all DAAP commands. -->

    <field name="RequestSpace" type="constant" length="1B" value="0x20"/>
    <!-- Space separating the HTTP method from the request target. -->

    <field name="RequestTarget" type="constant" length="7B" value="/logout"/>
    <!-- DAAP endpoint that ends the current server session. -->

    <field name="URISpace" type="constant" length="1B" value="0x20"/>
    <!-- Space separating the request target from the HTTP version. -->

    <field name="HTTPVersion" type="constant" length="8B" value="HTTP/1.1"/>
    <!-- HTTP protocol version used in the request line. -->

    <field name="RequestLineEnd" type="constant" length="2B" value="0x0D0A"/>
    <!-- CRLF terminating the HTTP request line. -->

    <field name="HostHeaderName" type="constant" length="4B" value="Host"/>
    <!-- HTTP/1.1 Host header name, present in the sample DAAP request. -->

    <field name="HostHeaderSeparator" type="constant" length="2B" value=": "/>
    <!-- Colon and space separating the Host header name from its value. -->

    <field name="HostValue" type="variable" length="undefined" value="ASCII characters allowed in an RFC 3986 host name, IP literal, or host:port"/>
    <!-- Host header value identifying the DAAP server. -->

    <field name="HostHeaderEnd" type="constant" length="2B" value="0x0D0A"/>
    <!-- CRLF terminating the Host header line. -->

    <field name="ClientDAAPVersionName" type="constant" length="19B" value="Client-DAAP-Version"/>
    <!-- DAAP-specific HTTP header name sent on DAAP requests. -->

    <field name="ClientDAAPVersionSeparator" type="constant" length="2B" value=": "/>
    <!-- Colon and space separating the Client-DAAP-Version header name from its value. -->

    <field name="ClientDAAPVersionValue" type="constant" length="3B" value="1.0"/>
    <!-- DAAP protocol version value sent by iTunes; servers tolerate its absence. -->

    <field name="ClientDAAPVersionEnd" type="constant" length="2B" value="0x0D0A"/>
    <!-- CRLF terminating the Client-DAAP-Version header line. -->

    <field name="HeadersEnd" type="constant" length="2B" value="0x0D0A"/>
    <!-- Empty line after the final HTTP header, marking the end of the request header section. Additional standard HTTP headers may appear before this final CRLF without affecting DAAP logout semantics. -->
</message>
  <message name="/databases/[num]/items">
    <!-- DAAP request path used to retrieve all songs from a specified database. This path is used as the request-URI of an HTTP GET request. -->
    <field name="DatabasePathPrefix" type="constant" length="11B" value="/databases/"/>
    <!-- Constant URI prefix identifying the DAAP database collection. -->
    <field name="DatabaseID" type="variable" length="undefined" value="0x30-0x39"/>
    <!-- Numeric database identifier; its length depends on the number of decimal digits in the database number. -->
    <field name="ItemsPathSuffix" type="constant" length="6B" value="/items"/>
    <!-- Constant URI suffix indicating that this resource is the item/song listing within the selected database. -->
</message>
  <message name="/login">
    <!-- Begins a DAAP session. The server returns a session ID in the DMAP-tagged response; a valid session is required to retrieve any real information (song list, playlists, etc...). -->
    <!-- The request is carried over HTTP/1.1 as a GET. The header set and order follow the sample request in the protocol description; header order may vary in practice. -->

    <field name="Method" type="constant" length="3B" value="GET"/>
    <!-- HTTP method used for all DAAP requests; DAAP uses HTTP GET to query the music server -->

    <field name="WhitespaceAfterMethod" type="constant" length="1B" value="0x20"/>
    <!-- Space separating the HTTP method from the request URI -->

    <field name="RequestURI" type="constant" length="6B" value="/login"/>
    <!-- DAAP login endpoint; this URL begins a new session on the server -->

    <field name="WhitespaceAfterURI" type="constant" length="1B" value="0x20"/>
    <!-- Space separating the request URI from the HTTP version -->

    <field name="HTTPVersion" type="constant" length="8B" value="HTTP/1.1"/>
    <!-- HTTP protocol version used to carry the DAAP request -->

    <field name="RequestLineCRLF" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed terminating the request line -->

    <field name="HostHeaderName" type="constant" length="5B" value="Host:"/>
    <!-- HTTP Host header field name; the value identifies the DAAP server hostname -->

    <field name="HostHeaderSeparator" type="constant" length="1B" value="0x20"/>
    <!-- Space separating the header name from the header value; HTTP allows optional whitespace, the sample uses one space -->

    <field name="HostHeaderValue" type="variable" length="undefined" value="DAAP server hostname (e.g., daap.example.com)"/>
    <!-- Hostname of the DAAP server to which the request is directed; required by HTTP/1.1 -->

    <field name="HostHeaderCRLF" type="constant" length="2B" value="0x0D0A"/>
    <!-- End of the Host header line -->

    <field name="AcceptHeaderName" type="constant" length="7B" value="Accept:"/>
    <!-- HTTP Accept header field name -->

    <field name="AcceptHeaderSeparator" type="constant" length="1B" value="0x20"/>
    <!-- Space separating the header name from the header value -->

    <field name="AcceptHeaderValue" type="variable" length="undefined" value="MIME types acceptable for the response; typically */*"/>
    <!-- Media types the client is willing to receive in the HTTP response -->

    <field name="AcceptHeaderCRLF" type="constant" length="2B" value="0x0D0A"/>
    <!-- End of the Accept header line -->

    <field name="UserAgentHeaderName" type="constant" length="11B" value="User-Agent:"/>
    <!-- HTTP User-Agent header field name -->

    <field name="UserAgentHeaderSeparator" type="constant" length="1B" value="0x20"/>
    <!-- Space separating the header name from the header value -->

    <field name="UserAgentHeaderValue" type="variable" length="undefined" value="Client software identifier (e.g., iTunes/4.0 (Macintosh; N; PPC))"/>
    <!-- Identifies the client software making the DAAP request; iTunes sends its version and platform -->

    <field name="UserAgentHeaderCRLF" type="constant" length="2B" value="0x0D0A"/>
    <!-- End of the User-Agent header line -->

    <field name="ClientDAAPVersionHeaderName" type="constant" length="20B" value="Client-DAAP-Version:"/>
    <!-- DAAP-specific extra header name indicating the DAAP protocol version -->

    <field name="ClientDAAPVersionHeaderSeparator" type="constant" length="1B" value="0x20"/>
    <!-- Space separating the header name from the header value -->

    <field name="ClientDAAPVersionValue" type="constant" length="3B" value="1.0"/>
    <!-- DAAP protocol version used by the client; iTunes sends "1.0". Some clients (curl/wget) omit it; the server tolerates its absence -->

    <field name="ClientDAAPVersionHeaderCRLF" type="constant" length="2B" value="0x0D0A"/>
    <!-- End of the Client-DAAP-Version header line -->

    <field name="AcceptEncodingHeaderName" type="constant" length="16B" value="Accept-Encoding:"/>
    <!-- HTTP Accept-Encoding header field name; DAAP servers transparently compress responses with gzip when accepted -->

    <field name="AcceptEncodingHeaderSeparator" type="constant" length="1B" value="0x20"/>
    <!-- Space separating the header name from the header value -->

    <field name="AcceptEncodingValue" type="variable" length="undefined" value="gzip or empty"/>
    <!-- Content encodings acceptable to the client; the DAAP server can send gzip-compressed or unencoded data. This header may be omitted -->

    <field name="AcceptEncodingHeaderCRLF" type="constant" length="2B" value="0x0D0A"/>
    <!-- End of the Accept-Encoding header line -->

    <field name="HeaderTerminator" type="constant" length="2B" value="0x0D0A"/>
    <!-- Empty line (CRLF) marking the end of the HTTP header block; since a GET request has no body, this also terminates the /login message -->
</message>
</ir>
