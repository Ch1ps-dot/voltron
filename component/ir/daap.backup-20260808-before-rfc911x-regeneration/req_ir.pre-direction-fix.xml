<?xml version='1.0' encoding='UTF-8' standalone='yes'?>
<ir>
  <message name="update">
  <!-- Root message for a DAAP /update response; the body is a top-level "mupd" container chunk. -->
  <field name="mupd" type="constant" length="B" value="mupd">
    <!-- Top-level chunk content code: "mupd" identifies the update response. -->
  </field>
  <field name="mupd_length" type="variable" length="B" value="0..4294967295">
    <!-- Contents length of the top-level chunk; spec says ignore this and recompute from total length if needed. -->
  </field>
  <field name="mstt" type="constant" length="B" value="mstt">
    <!-- Child chunk content code: "mstt" identifies the DAAP status. -->
  </field>
  <field name="mstt_length" type="constant" length="B" value="4">
    <!-- Status data length: status is a 4-byte long. -->
  </field>
  <field name="status" type="variable" length="B" value="0..4294967295">
    <!-- DAAP status code; a normal update response contains 200. -->
  </field>
  <field name="musr" type="constant" length="B" value="musr">
    <!-- Child chunk content code: "musr" identifies the update revision. -->
  </field>
  <field name="musr_length" type="constant" length="B" value="4">
    <!-- Revision data length: revision is a 4-byte long. -->
  </field>
  <field name="revision" type="variable" length="B" value="0..4294967295">
    <!-- Current revision number returned by /update. -->
  </field>
</message>
  <message name="login">
  <field name="request_uri" type="constant" length="B" value="/login">
    <!-- Fixed DAAP request URI; begins a session. -->
  </field>
</message>
  <message name="database-items">
  <field name="Content code" type="constant" length="B" value="dmap"/>
  <!-- Fixed top-level DMAP magic/OSType; every DAAP response is wrapped in the 'dmap' chunk. -->
  <field name="Length" type="variable" length="B" value="0..4294967295"/>
  <!-- Big-endian length of Data only; the top-level length may be unreliable, so Data length is derived from the enclosing HTTP body size. -->
  <field name="Data" type="variable" length="undefined" value="*(chunk)"/>
  <!-- Container payload: child chunks in sequence; for /databases/[num]/items this is the song listing chunk data. -->
</message>
  <message name="logout">
  <field name="request-uri" type="constant" length="B" value="/logout"/>
  <!-- /logout ends a DAAP session; the request URI is fixed and no other fields are specified. -->
</message>
  <message name="content-codes">
  <field name="top_level_content_code" type="constant" length="B" value="mccf">
    <!-- 4-byte OSType tag for the content-codes response; fixed magic for this message. -->
  </field>
  <field name="top_level_content_length" type="variable" length="B" value="total_data_length - 8">
    <!-- 4-byte big-endian length of the chunk data. Top-level DAAP lengths are unreliable, so derive from total response body length minus the 4-byte content code and 4-byte length field. -->
  </field>
  <field name="content_code_entries" type="variable" length="undefined" value="sequence of mlit chunks">
    <!-- Contents of the top-level chunk: one mlit chunk per content code definition. -->
    <field name="entry_content_code" type="constant" length="B" value="mlit">
      <!-- 4-byte OSType tag for a content-code listing item. -->
    </field>
    <field name="entry_content_length" type="variable" length="B" value="0x00000000..0xffffffff">
      <!-- 4-byte big-endian length of this mlit data; child lengths are reliable. -->
    </field>
    <field name="mcon_content_code" type="constant" length="B" value="mcon">
      <!-- 4-byte OSType tag: the content code being described. -->
    </field>
    <field name="mcon_content_length" type="constant" length="B" value="0x00000004">
      <!-- 4-byte big-endian length; mcon data is always 4 bytes. -->
    </field>
    <field name="content_code_value" type="variable" length="B" value="4-byte OSType unsigned long">
      <!-- The actual content code, e.g. minm; big-endian OSType. -->
    </field>
    <field name="mcty_content_code" type="constant" length="B" value="mcty">
      <!-- 4-byte OSType tag: the data type of the described content code. -->
    </field>
    <field name="mcty_content_length" type="constant" length="B" value="0x00000001">
      <!-- 4-byte big-endian length; mcty data is always 1 byte. -->
    </field>
    <field name="content_code_type" type="variable" length="B" value="1|3|5|7|9|10|11|12">
      <!-- One-byte type number from the Content Types table. -->
    </field>
    <field name="mcnm_content_code" type="constant" length="B" value="mcnm">
      <!-- 4-byte OSType tag: long name of the content code. -->
    </field>
    <field name="mcnm_content_length" type="variable" length="B" value="0x00000000..0xffffffff">
      <!-- 4-byte big-endian length of the UTF-8 name data, in bytes. -->
    </field>
    <field name="content_code_name" type="variable" length="undefined" value="UTF-8 string">
      <!-- Long name; its byte length is given by the preceding mcnm_content_length. -->
    </field>
  </field>
</message>
  <message name="server-info">
  <!-- DMAP tagged response body for GET /server-info; all integers are big-endian. -->
  <field name="msrv.code" type="constant" length="B" value="6d737276"/><!-- Content code for dmap.serverinforesponse ('msrv'), the root container. -->
  <field name="msrv.length" type="variable" length="B" value="0x00000000-0xffffffff"/><!-- Root container content length; the spec says this top-level length is unreliable and should be recomputed as total body length minus 8. -->
  <field name="mstt.code" type="constant" length="B" value="6d737474"/><!-- Content code for dmap.status ('mstt'). -->
  <field name="mstt.length" type="constant" length="B" value="00000004"/><!-- Length of dmap.status value: 4-byte long. -->
  <field name="mstt.value" type="constant" length="B" value="000000c8"/><!-- dmap.status = 200 success code. -->
  <field name="mpro.code" type="constant" length="B" value="6d70726f"/><!-- Content code for dmap.protocolversion ('mpro'). -->
  <field name="mpro.length" type="constant" length="B" value="00000004"/><!-- Version type length: 2-byte major, 1-byte minor, 1-byte patch. -->
  <field name="mpro.value" type="constant" length="B" value="00010000"/><!-- DMAP protocol version 1.0.0. -->
  <field name="apro.code" type="constant" length="B" value="6170726f"/><!-- Content code for daap.protocolversion ('apro'). -->
  <field name="apro.length" type="constant" length="B" value="00000004"/><!-- Version type length: 2-byte major, 1-byte minor, 1-byte patch. -->
  <field name="apro.value" type="constant" length="B" value="00010000"/><!-- DAAP protocol version 1.0.0. -->
  <field name="minm.code" type="constant" length="B" value="6d696e6d"/><!-- Content code for dmap.itemname ('minm'). -->
  <field name="minm.length" type="variable" length="B" value="0x00000000-0xffffffff"/><!-- Length of the UTF-8 server name; must equal the byte length of minm.value. -->
  <field name="minm.value" type="variable" length="undefined" value="UTF-8 string"/><!-- Server name; sample "Example Server" is 4578616d706c6520536572766572. -->
  <field name="mslr.code" type="constant" length="B" value="6d736c72"/><!-- Content code for dmap.loginrequired ('mslr'). -->
  <field name="mslr.length" type="constant" length="B" value="00000001"/><!-- Length of dmap.loginrequired value: 1-byte char. -->
  <field name="mslr.value" type="variable" length="B" value="0x00-0xff"/><!-- Boolean char: 0 means login not required; nonzero means login required. Sample value is 00. -->
  <field name="mstm.code" type="constant" length="B" value="6d73746d"/><!-- Content code for dmap.timeoutinterval ('mstm'). -->
  <field name="mstm.length" type="constant" length="B" value="00000004"/><!-- Length of dmap.timeoutinterval value: 4-byte long. -->
  <field name="mstm.value" type="variable" length="B" value="0x00000000-0xffffffff"/><!-- Timeout interval in seconds; sample value 1800 is 00000708. -->
  <field name="msal.code" type="constant" length="B" value="6d73616c"/><!-- Content code for dmap.supportsautologout ('msal'). -->
  <field name="msal.length" type="constant" length="B" value="00000001"/><!-- Length of dmap.supportsautologout value: 1-byte char. -->
  <field name="msal.value" type="variable" length="B" value="0x00-0xff"/><!-- Boolean char: indicates whether the server supports automatic logout. Sample value is 00. -->
  <field name="msup.code" type="constant" length="B" value="6d737570"/><!-- Content code for dmap.supportsupdate ('msup'). -->
  <field name="msup.length" type="constant" length="B" value="00000001"/><!-- Length of dmap.supportsupdate value: 1-byte char. -->
  <field name="msup.value" type="variable" length="B" value="0x00-0xff"/><!-- Boolean char: indicates whether the server supports /update. Sample value is 00. -->
  <field name="mspi.code" type="constant" length="B" value="6d737069"/><!-- Content code for dmap.supportspersistentids ('mspi'). -->
  <field name="mspi.length" type="constant" length="B" value="00000001"/><!-- Length of dmap.supportspersistentids value: 1-byte char. -->
  <field name="mspi.value" type="variable" length="B" value="0x00-0xff"/><!-- Boolean char: indicates whether the server supports persistent IDs. Sample value is 00. -->
  <field name="msex.code" type="constant" length="B" value="6d736578"/><!-- Content code for dmap.supportsextensions ('msex'). -->
  <field name="msex.length" type="constant" length="B" value="00000001"/><!-- Length of dmap.supportsextensions value: 1-byte char. -->
  <field name="msex.value" type="variable" length="B" value="0x00-0xff"/><!-- Boolean char; support for extensions is marked uncertain in the source. Sample value is 00. -->
  <field name="msbr.code" type="constant" length="B" value="6d736272"/><!-- Content code for dmap.supportsbrowse ('msbr'). -->
  <field name="msbr.length" type="constant" length="B" value="00000001"/><!-- Length of dmap.supportsbrowse value: 1-byte char. -->
  <field name="msbr.value" type="variable" length="B" value="0x00-0xff"/><!-- Boolean char; support for browse is marked uncertain in the source. Sample value is 00. -->
  <field name="msqy.code" type="constant" length="B" value="6d737179"/><!-- Content code for dmap.supportsquery ('msqy'). -->
  <field name="msqy.length" type="constant" length="B" value="00000001"/><!-- Length of dmap.supportsquery value: 1-byte char. -->
  <field name="msqy.value" type="variable" length="B" value="0x00-0xff"/><!-- Boolean char; support for query is marked uncertain in the source. Sample value is 00. -->
  <field name="msix.code" type="constant" length="B" value="6d736978"/><!-- Content code for dmap.supportsindex ('msix'). -->
  <field name="msix.length" type="constant" length="B" value="00000001"/><!-- Length of dmap.supportsindex value: 1-byte char. -->
  <field name="msix.value" type="variable" length="B" value="0x00-0xff"/><!-- Boolean char; support for index is marked uncertain in the source. Sample value is 00. -->
  <field name="msrs.code" type="constant" length="B" value="6d737273"/><!-- Content code for dmap.supportsresolve ('msrs'). -->
  <field name="msrs.length" type="constant" length="B" value="00000001"/><!-- Length of dmap.supportsresolve value: 1-byte char. -->
  <field name="msrs.value" type="variable" length="B" value="0x00-0xff"/><!-- Boolean char: indicates whether the server supports /resolve. Sample value is 00. -->
  <field name="msdc.code" type="constant" length="B" value="6d736463"/><!-- Content code for dmap.databasescount ('msdc'). -->
  <field name="msdc.length" type="constant" length="B" value="00000004"/><!-- Length of dmap.databasescount value: 4-byte long. -->
  <field name="msdc.value" type="variable" length="B" value="0x00000000-0xffffffff"/><!-- Number of databases known to the server; sample value 1 is 00000001. -->
</message>
  <message name="database-containers">
  <field name="content_code" type="constant" length="B" value="mlcl"/>
  <!-- Fixed 4-byte OSType code for the container list returned for /databases/[num]/containers. -->
  <field name="length" type="variable" length="B" value="0x00000000-0xffffffff"/>
  <!-- 4-byte big-endian length of the following data; for the top-level chunk this length is unreliable and should be ignored. -->
  <field name="data" type="variable" length="undefined" value="chunk*"/>
  <!-- Container payload (type 12): zero or more child chunks, one per playlist; child chunk lengths are reliable. -->
</message>
  <message name="resolve">
  <!-- Top-level DAAP chunk for /resolve; the specification does not document fields specific to /resolve. -->
  <field name="contentCode" type="variable" length="B" value="OSType (4 bytes, big-endian)"/>
  <!-- Fixed-size OSType identifying the chunk; the exact /resolve code is not supplied by the evidence. -->
  <field name="length" type="variable" length="B" value="unsigned long (4 bytes, big-endian)"/>
  <!-- Declared byte length of Data. For a top-level /resolve chunk, this length is unreliable per the spec and should be ignored. -->
  <field name="data" type="variable" length="undefined" value="opaque chunk data"/>
  <!-- Variable-length payload; no /resolve-specific child chunks are specified in the provided excerpt. -->
</message>
  <message name="database-container-items">
  <field name="Content code" type="constant" length="B" value="mlcl"/>
  <!-- OSType 'mlcl' marks this as a DAAP listing-container response; wire bytes are 6d 6c 63 6c. -->
  <field name="Length" type="variable" length="B" value="0..4294967295"/>
  <!-- Big-endian length of the Data field only; the spec says the top-level Length can be wrong, so recompute it as the response body length minus 8 when parsing the top-level chunk. -->
  <field name="Data" type="variable" length="undefined" value="container"/>
  <!-- Content type 12 (container): the Data bytes are a series of child chunks, one after another; for this endpoint they are the playlist item chunks. -->
</message>
</ir>
