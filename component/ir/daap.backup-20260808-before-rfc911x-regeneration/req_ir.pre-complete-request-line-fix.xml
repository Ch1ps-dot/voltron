<?xml version='1.0' encoding='UTF-8' standalone='yes'?>
<ir>
  <message name="content-codes">
  <field name="method" type="constant" length="B" value="GET"/> <!-- Fixed HTTP method for this DAAP request. -->
  <field name="request-target" type="constant" length="B" value="/content-codes"/> <!-- Fixed path identifying the content-codes resource; sample has no query. -->
  <field name="http-version" type="constant" length="B" value="HTTP/1.1"/> <!-- HTTP version on the request line; sample uses 1.1. -->
  <field name="host" type="variable" length="undefined" value="daap.example.com"/> <!-- Origin-server authority; sample host, varies by server; HTTP/1.1 requires Host. -->
  <field name="client-daap-version" type="constant" length="B" value="1.0"/> <!-- Exact DAAP client protocol version in sample. -->
  <field name="user-agent" type="variable" length="undefined" value="iTunes/4.0 (Macintosh; N; PPC)"/> <!-- Client product token; sample from iTunes/4.0, not fixed by DAAP. -->
  <field name="accept-language" type="variable" length="undefined" value="en-us, en;q=0.93, ..."/> <!-- Variable language-range list; remaining sample values elided in spec. -->
  <field name="accept-encoding" type="variable" length="undefined" value="gzip"/> <!-- Accepted content coding; sample is gzip. -->
</message>
  <message name="database-containers">
  <field name="databases-prefix" type="constant" length="B" value="/databases/"/>
  <!-- Fixed URI prefix from /databases/[num]/containers. -->
  <field name="num" type="variable" length="undefined" value="[0-9]+"/>
  <!-- [num] is the numeric database identifier in the request URI. -->
  <field name="containers-suffix" type="constant" length="B" value="/containers"/>
  <!-- Fixed URI suffix selecting the container/playlist list. -->
</message>
  <message name="update" note="Direction: request; DAAP /update is issued as an HTTP request-line GET.">
  <field name="method" type="constant" length="B" value="GET" note="Fixed HTTP method."/>
  <field name="method-separator" type="constant" length="B" value=" " note="Space before request-target."/>
  <field name="path" type="constant" length="B" value="/update" note="DAAP update endpoint (spec 4.5)."/>
  <field name="query-start" type="constant" length="B" value="?" note="Origin-form query delimiter."/>
  <field name="query-parameter-name" type="constant" length="B" value="revision-number=" note="Fixed query parameter; the client supplies the last revision it has."/>
  <field name="revision-number" type="variable" length="undefined" value="1*DIGIT" note="Decimal revision number; DAAP numeric revision is an unsigned integer."/>
  <field name="target-separator" type="constant" length="B" value=" " note="Space before HTTP version."/>
  <field name="http-version" type="constant" length="B" value="HTTP/1.1" note="Fixed protocol version."/>
  <field name="request-line-end" type="constant" length="B" value="&#13;&#10;" note="CRLF ending the request line."/>
</message>
  <message name="resolve">
    <field name="method" type="constant" length="3B" value="GET"/><!-- DAAP resolve requests are HTTP GET requests. -->
    <field name="method-space" type="constant" length="1B" value=" "/><!-- Space after the HTTP method token. -->
    <field name="request-target" type="variable" length="undefined" value="/resolve"/><!-- Fixed path from §4.10; an optional query component may follow per http-URI grammar, but no exact query fields are specified. -->
    <field name="target-space" type="constant" length="1B" value=" "/><!-- Space between request target and HTTP version. -->
    <field name="http-version" type="constant" length="8B" value="HTTP/1.1"/><!-- HTTP/1.1 version token; see RFC 9112 §2.5. -->
    <field name="request-line-end" type="constant" length="2B" value="\r\n"/><!-- CRLF terminating the request line. -->
    <field name="request-header-fields" type="variable" length="undefined" value="*( field-line CRLF )"/><!-- Generic HTTP request header section; DAAP-specific headers are not supplied in the /resolve evidence. -->
    <field name="header-section-end" type="constant" length="2B" value="\r\n"/><!-- Final CRLF (empty line) ending the header section. -->
</message>
  <message name="database-items">
  <field name="method" type="constant" length="B" value="GET"/>
  <!-- DAAP request URIs are issued with HTTP GET. -->
  <field name="space-after-method" type="constant" length="B" value=" "/>
  <!-- HTTP request-line space separator. -->
  <field name="path-prefix" type="constant" length="B" value="/databases/"/>
  <!-- Fixed path prefix from the DAAP spec: /databases/[num]/items. -->
  <field name="database-id" type="variable" length="undefined" value="[0-9]+"/>
  <!-- Variable database identifier represented by [num] in the request URI. -->
  <field name="path-suffix" type="constant" length="B" value="/items"/>
  <!-- Fixed path suffix selecting the items collection of the database. -->
  <field name="space-before-version" type="constant" length="B" value=" "/>
  <!-- HTTP request-line space separator before the version token. -->
  <field name="http-version" type="constant" length="B" value="HTTP/1.1"/>
  <!-- HTTP/1.1 version token used on the request line. -->
  <field name="crlf" type="constant" length="B" value="&#13;&#10;"/>
  <!-- CRLF terminator for the HTTP request line; no additional DAAP-specific fields are specified. -->
</message>
  <message name="login">
  <field name="method" type="constant" length="B" value="GET"/>
  <!-- DAAP login is performed as an HTTP GET request; no request body is defined. -->
  <field name="method_separator" type="constant" length="B" value=" "/>
  <!-- Single SP separates the HTTP method from the request target. -->
  <field name="request_target" type="constant" length="B" value="/login"/>
  <!-- Section 4.3 fixes the request URI to /login; no query string is present at session start. -->
  <field name="target_separator" type="constant" length="B" value=" "/>
  <!-- Single SP separates the request target from the HTTP version. -->
  <field name="http_version" type="constant" length="B" value="HTTP/1.1"/>
  <!-- HTTP/1.1 messaging version used by DAAP requests. -->
  <field name="request_line_end" type="constant" length="B" value="&#13;&#10;"/>
  <!-- CRLF terminates the request line. -->
  <field name="host_field_name" type="constant" length="B" value="Host"/>
  <!-- HTTP/1.1 Host field carries the origin authority from the http URI scheme. -->
  <field name="host_field_colon" type="constant" length="B" value=":"/>
  <!-- Colon separates the field name from the field value. -->
  <field name="host_field_value" type="variable" length="undefined" value="authority"/>
  <!-- Variable authority: host identifier and optional port, depending on the target server. -->
  <field name="host_field_end" type="constant" length="B" value="&#13;&#10;"/>
  <!-- CRLF terminates the Host field line. -->
  <field name="header_section_end" type="constant" length="B" value="&#13;&#10;"/>
  <!-- Final CRLF terminates the header section; /login has no request body. -->
</message>
  <message name="logout">
  <field name="method" type="constant" length="undefined" value="GET"/>
  <!-- DAAP logout is sent as an HTTP GET request. -->
  <field name="request-target" type="constant" length="undefined" value="/logout"/>
  <!-- Exact request URI from DAAP spec section 4.4. -->
  <field name="http-version" type="constant" length="undefined" value="HTTP/1.1"/>
  <!-- HTTP/1.1 protocol version token in the request line. -->
  <field name="host" type="variable" length="undefined" value="[authority]"/>
  <!-- Required HTTP/1.1 Host header value; variable server authority from the http URI scheme. -->
</message>
  <message name="server-info">
  <field name="method" type="constant" length="B" value="GET"/><!-- HTTP method; DAAP requests are GET. -->
  <field name="request-target" type="constant" length="B" value="/server-info"/><!-- Fixed server-info request path. -->
  <field name="http-version" type="constant" length="B" value="HTTP/1.1"/><!-- HTTP version token fixed in the DAAP sample. -->
  <field name="Host" type="variable" length="undefined" value="uri-host [ : port ]"/><!-- HTTP Host header; sample value is daap.example.com. -->
  <field name="Accept" type="variable" length="undefined" value="media-range"/><!-- HTTP Accept header; DAAP sample sends */*. -->
  <field name="User-Agent" type="variable" length="undefined" value="product"/><!-- HTTP User-Agent header; sample is iTunes/4.0. -->
  <field name="Client-DAAP-Version" type="constant" length="B" value="1.0"/><!-- DAAP-specific request header; iTunes sends 1.0. -->
  <field name="Accept-Encoding" type="variable" length="undefined" value="content-coding"/><!-- HTTP Accept-Encoding header; DAAP sample uses gzip. -->
</message>
  <message name="database-container-items">
  <field name="literal_databases" type="constant" length="B" value="/databases/"/>
  <!-- Fixed request-target prefix for the DAAP playlist-items database resource. -->
  <field name="database_id" type="variable" length="undefined" value="[0-9]+"/>
  <!-- Database identifier from the URI template [num]; ASCII decimal, no separate length field. -->
  <field name="literal_containers" type="constant" length="B" value="/containers/"/>
  <!-- Fixed path segment separating the database id from the container id. -->
  <field name="container_id" type="variable" length="undefined" value="[0-9]+"/>
  <!-- Container/playlist identifier from the URI template [num]; ASCII decimal, no separate length field. -->
  <field name="literal_items" type="constant" length="B" value="/items"/>
  <!-- Fixed suffix selecting the items collection inside the container. -->
</message>
</ir>
