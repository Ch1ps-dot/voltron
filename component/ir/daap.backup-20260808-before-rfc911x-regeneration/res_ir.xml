<?xml version='1.0' encoding='UTF-8' standalone='yes'?>
<ir>
  <message name="DAAPResponse">
    <!-- DAAP response body. The HTTP response entity is a single DMAP tagged chunk; all multi-byte values are big-endian. HTTP headers and gzip encoding are outside this message definition. -->

    <field name="ContentCode" type="variable" length="4B" value="4-byte OSType code: 'msrv', 'mccr', 'mlog', 'mupd', 'avdb', ..."/>
    <!-- Top-level content code identifying the response container. Examples: 'msrv' = server info response, 'mccr' = content codes response, 'mlog' = login response, 'mupd' = update response. -->

    <field name="ContentLength" type="variable" length="4B" value="0..4294967295"/>
    <!-- Big-endian unsigned length of the Data field only; it does not include the ContentCode and ContentLength header bytes. Some servers send an incorrect top-level length, so robust decoders may need to derive the top-level Data size from the HTTP body length minus 8. -->

    <field name="Data" type="variable" length="undefined" value="Sequence of zero or more nested chunks, each using the same [ContentCode(4B) + ContentLength(4B) + Data] layout"/>
    <!-- The payload consists of child tagged chunks. For a server info response (ContentCode = 'msrv'), the child chunk sequence is: 'mstt', 'mpro', 'apro', 'minm', 'mslr', 'mstm', 'msal', 'msup', 'mspi', 'msex', 'msbr', 'msqy', 'msix', 'msrs', 'msdc'. For a content codes response (ContentCode = 'mccr'), it contains 'mstt' followed by one or more 'mdcl' dictionaries. The Data length is normally the value of ContentLength; however, the top-level ContentLength is known to be unreliable, so use total HTTP body length minus 8 when parsing the top-level chunk. -->
</message>
</ir>
