<?xml version='1.0' encoding='UTF-8' standalone='yes'?>
<ir>
  <message name="logout">
    <!-- DAAP logout uses the HTTP GET method. -->
    <field name="method" type="constant" length="B" value="GET"/>
    <!-- Single space between the method and request-target. -->
    <field name="method-separator" type="constant" length="B" value=" "/>
    <!-- Fixed /logout path for this message; HTTP request-target grammar permits variable origin-form paths. -->
    <field name="request-target" type="variable" length="undefined" value="/logout"/>
    <!-- Single space between the request-target and HTTP version. -->
    <field name="request-target-separator" type="constant" length="B" value=" "/>
    <!-- HTTP version shown in DAAP request lines. -->
    <field name="http-version" type="constant" length="B" value="HTTP/1.1"/>
    <!-- CRLF terminates the request line; logout has no request body. -->
    <field name="line-ending" type="constant" length="B" value="&#13;&#10;"/>
</message>
  <message name="resolve">
  <field name="method" type="constant" length="B" value="GET"/>
  <!-- DAAP requests use the HTTP GET method. -->
  <field name="method-space" type="constant" length="B" value=" "/>
  <!-- Space separating the method from the request-target. -->
  <field name="request-target" type="constant" length="B" value="/resolve"/>
  <!-- Full HTTP request-target from DAAP section 4.10; the leading slash is part of the wire value. -->
  <field name="target-space" type="constant" length="B" value=" "/>
  <!-- Space separating the request-target from the HTTP version. -->
  <field name="http-version" type="constant" length="B" value="HTTP/1.1"/>
  <!-- HTTP version used by the DAAP sample request. -->
  <field name="request-line-crlf" type="constant" length="B" value="&#13;&#10;"/>
  <!-- CRLF terminates the HTTP request line. -->
  <field name="host-header-name" type="constant" length="B" value="Host: "/>
  <!-- HTTP/1.1 Host header field-name; required for request framing. -->
  <field name="host-header-value" type="variable" length="undefined" value="[^\r\n]+"/>
  <!-- Destination host and optional port; varies per DAAP server. -->
  <field name="host-header-crlf" type="constant" length="B" value="&#13;&#10;"/>
  <!-- CRLF terminates the Host header. -->
  <field name="client-daap-version-header-name" type="constant" length="B" value="Client-DAAP-Version: "/>
  <!-- DAAP-specific extra header from DAAP section 2. -->
  <field name="client-daap-version-header-value" type="constant" length="B" value="1.0"/>
  <!-- Version value sent by iTunes; specified as 1.0. -->
  <field name="client-daap-version-header-crlf" type="constant" length="B" value="&#13;&#10;"/>
  <!-- CRLF terminates the Client-DAAP-Version header. -->
  <field name="header-terminator" type="constant" length="B" value="&#13;&#10;"/>
  <!-- Empty line ends the header section; this GET request has no body. -->
</message>
  <message name="update">
  <field name="method" type="constant" length="B" value="GET"><!-- HTTP method; all DAAP requests use GET (Section 2). --></field>
  <field name="method-space" type="constant" length="B" value=" "><!-- Single SP separating method and request-target. --></field>
  <field name="request-target" type="constant" length="B" value="/update"><!-- DAAP update resource; returns the current revision number (Section 4.5). --></field>
  <field name="target-space" type="constant" length="B" value=" "><!-- Single SP separating request-target and HTTP version. --></field>
  <field name="http-version" type="constant" length="B" value="HTTP/1.1"><!-- HTTP version from the sample request framing. --></field>
  <field name="request-line-crlf" type="constant" length="B" value="&#13;&#10;"><!-- End of request line. --></field>
  <field name="host-header-prefix" type="constant" length="B" value="Host: "><!-- Fixed HTTP Host header prefix. --></field>
  <field name="host-header-value" type="variable" length="undefined" value="daap.example.com"><!-- Server host from the sample; actual value is the target DAAP server. --></field>
  <field name="host-header-crlf" type="constant" length="B" value="&#13;&#10;"><!-- End of Host header. --></field>
  <field name="accept-header-prefix" type="constant" length="B" value="Accept: "><!-- Fixed HTTP Accept header prefix. --></field>
  <field name="accept-header-value" type="constant" length="B" value="*/*"><!-- Accept any representation; value from the sample request. --></field>
  <field name="accept-header-crlf" type="constant" length="B" value="&#13;&#10;"><!-- End of Accept header. --></field>
  <field name="user-agent-header-prefix" type="constant" length="B" value="User-Agent: "><!-- Fixed HTTP User-Agent header prefix. --></field>
  <field name="user-agent-header-value" type="variable" length="undefined" value="iTunes/4.0 (Macintosh; N; PPC)"><!-- DAAP client identifier; sample value, may vary by client. --></field>
  <field name="user-agent-header-crlf" type="constant" length="B" value="&#13;&#10;"><!-- End of User-Agent header. --></field>
  <field name="client-daap-version-header-prefix" type="constant" length="B" value="Client-DAAP-Version: "><!-- Fixed DAAP-specific request header prefix. --></field>
  <field name="client-daap-version-header-value" type="constant" length="B" value="1.0"><!-- DAAP protocol version sent by iTunes (Section 2). --></field>
  <field name="client-daap-version-header-crlf" type="constant" length="B" value="&#13;&#10;"><!-- End of Client-DAAP-Version header. --></field>
  <field name="accept-encoding-header-prefix" type="constant" length="B" value="Accept-Encoding: "><!-- Fixed HTTP Accept-Encoding header prefix. --></field>
  <field name="accept-encoding-header-value" type="constant" length="B" value="gzip"><!-- Request gzip encoding, as in the sample request. --></field>
  <field name="accept-encoding-header-crlf" type="constant" length="B" value="&#13;&#10;"><!-- End of Accept-Encoding header. --></field>
  <field name="header-terminator" type="constant" length="B" value="&#13;&#10;"><!-- Empty line after headers; the update request has no body. --></field>
</message>
  <message name="database-containers">
  <field name="method" type="constant" length="B" value="GET"/><!-- HTTP method; DAAP requests are always GET. -->
  <field name="method-space" type="constant" length="B" value=" "/><!-- Space separating method and request-target. -->
  <field name="path-prefix" type="constant" length="B" value="/databases/"/><!-- Fixed prefix of the containers resource URI. -->
  <field name="database-id" type="variable" length="undefined" value="[0-9]+"/><!-- Numeric database id ([num] from spec section 4.8). -->
  <field name="path-suffix" type="constant" length="B" value="/containers"/><!-- Fixed suffix naming the containers/playlists resource. -->
  <field name="version-space" type="constant" length="B" value=" "/><!-- Space before HTTP version. -->
  <field name="http-version" type="constant" length="B" value="HTTP/1.1"/><!-- HTTP version used in the sample request. -->
  <field name="request-line-crlf" type="constant" length="B" value="&#13;&#10;"/><!-- CRLF ends the request line. -->
  <field name="host-header-name" type="constant" length="B" value="Host"/><!-- HTTP/1.1 Host header. -->
  <field name="host-header-separator" type="constant" length="B" value=": "/><!-- Header name/value separator. -->
  <field name="host-header-value" type="variable" length="undefined" value="host[:port]"/><!-- DAAP server host, optionally with port 3689. -->
  <field name="host-header-crlf" type="constant" length="B" value="&#13;&#10;"/><!-- CRLF ends the Host header. -->
  <field name="daap-version-header-name" type="constant" length="B" value="Client-DAAP-Version"/><!-- DAAP protocol version header. -->
  <field name="daap-version-header-separator" type="constant" length="B" value=": "/><!-- Header separator. -->
  <field name="daap-version-header-value" type="constant" length="B" value="1.0"/><!-- iTunes sends DAAP version 1.0. -->
  <field name="daap-version-header-crlf" type="constant" length="B" value="&#13;&#10;"/><!-- CRLF ends the DAAP version header. -->
  <field name="accept-encoding-header-name" type="constant" length="B" value="Accept-Encoding"/><!-- Header announcing acceptable encodings. -->
  <field name="accept-encoding-header-separator" type="constant" length="B" value=": "/><!-- Header separator. -->
  <field name="accept-encoding-header-value" type="constant" length="B" value="gzip"/><!-- gzip content encoding used by iTunes requests. -->
  <field name="accept-encoding-header-crlf" type="constant" length="B" value="&#13;&#10;"/><!-- CRLF ends the Accept-Encoding header. -->
  <field name="request-end-crlf" type="constant" length="B" value="&#13;&#10;"/><!-- Empty line terminates the HTTP request header block. -->
</message>
  <message name="container-items">
  <field name="method" type="constant" length="B" value="GET"/>
  <!-- DAAP requests use HTTP GET (spec section 2). -->
  <field name="space-before-target" type="constant" length="B" value="0x20"/>
  <!-- Single space in the request line after the method. -->
  <field name="request-target" type="variable" length="undefined" value="/databases/{database-id}/containers/{container-id}/items"/>
  <!-- DAAP spec section 4.9 endpoint; database-id and container-id are unsigned decimal integers ([0-9]+). -->
  <field name="space-before-version" type="constant" length="B" value="0x20"/>
  <!-- Single space in the request line before the HTTP version. -->
  <field name="http-version" type="constant" length="B" value="HTTP/1.1"/>
  <!-- HTTP version from the DAAP sample request. -->
  <field name="request-line-crlf" type="constant" length="B" value="0x0D0A"/>
  <!-- CRLF terminates the request line. -->
  <field name="host-header" type="variable" length="undefined" value="Host: {host}"/>
  <!-- HTTP/1.1 Host header; {host} is the DAAP server authority, e.g. daap.example.com. -->
  <field name="host-header-crlf" type="constant" length="B" value="0x0D0A"/>
  <!-- CRLF terminates the Host header. -->
  <field name="client-daap-version-header" type="constant" length="B" value="Client-DAAP-Version: 1.0"/>
  <!-- The DAAP-specific request header; iTunes sends value 1.0 (spec section 2). -->
  <field name="daap-header-crlf" type="constant" length="B" value="0x0D0A"/>
  <!-- CRLF terminates the Client-DAAP-Version header. -->
  <field name="header-terminator" type="constant" length="B" value="0x0D0A"/>
  <!-- Blank line terminating the HTTP header section; GET has no request body. -->
</message>
  <message name="database-items">
  <field name="method" type="constant" length="undefined" value="GET"/>
  <!-- HTTP request method; DAAP requests use GET. -->
  <field name="space-after-method" type="constant" length="undefined" value=" "/>
  <!-- Single space separating the method and request-target. -->
  <field name="request-target" type="variable" length="undefined" value="/databases/{num}/items"/>
  <!-- Full request-target in origin-form; {num} is the numeric database id from section 4.7. -->
  <field name="space-before-version" type="constant" length="undefined" value=" "/>
  <!-- Single space separating the request-target and HTTP version. -->
  <field name="http-version" type="constant" length="undefined" value="HTTP/1.1"/>
  <!-- HTTP version used in the sample DAAP request. -->
  <field name="request-line-crlf" type="constant" length="undefined" value="\r\n"/>
  <!-- CRLF framing terminating the request line. -->
  <field name="host-header" type="variable" length="undefined" value="Host: {host}\r\n"/>
  <!-- HTTP/1.1 Host header; {host} is the target DAAP server authority, optionally including port 3689. -->
  <field name="client-daap-version-header" type="constant" length="undefined" value="Client-DAAP-Version: 1.0\r\n"/>
  <!-- DAAP-specific header; exact fixed value from section 2. -->
  <field name="header-terminator" type="constant" length="undefined" value="\r\n"/>
  <!-- Empty line terminating the header section; the request has no body. -->
</message>
  <message name="content-codes">
  <field name="request-line" type="constant" length="B" value="GET /content-codes HTTP/1.1&#13;&#10;"/>
  <!-- Complete HTTP request line: method GET, full request-target /content-codes, HTTP version 1.1, CRLF framing. -->
  <field name="host-header-name" type="constant" length="B" value="Host: "/>
  <!-- HTTP/1.1 Host header field name; a Host header is required on the wire. -->
  <field name="host-value" type="variable" length="undefined" value="daap.example.com"/>
  <!-- Host authority from the sample request; variable per server endpoint. -->
  <field name="host-header-ending" type="constant" length="B" value="&#13;&#10;"/>
  <!-- CRLF terminating the Host header. -->
  <field name="daap-version-header-name" type="constant" length="B" value="Client-DAAP-Version: "/>
  <!-- DAAP-specific HTTP header name from the sample request. -->
  <field name="daap-version-value" type="constant" length="B" value="1.0"/>
  <!-- DAAP version value sent by iTunes; fixed value from Basic Form. -->
  <field name="daap-version-header-ending" type="constant" length="B" value="&#13;&#10;"/>
  <!-- CRLF terminating the Client-DAAP-Version header. -->
  <field name="header-terminator" type="constant" length="B" value="&#13;&#10;"/>
  <!-- Empty line ending the HTTP header section; the content-codes request has no request body. -->
</message>
  <message name="server-info">
  <field name="method" type="constant" length="B" value="GET"/>
  <!-- DAAP requests use the HTTP GET method. -->
  <field name="space-after-method" type="constant" length="B" value=" "/>
  <!-- SP separator in the request line. -->
  <field name="request-target" type="constant" length="B" value="/server-info"/>
  <!-- Complete request-target for this message; the leading slash is required. -->
  <field name="space-after-request-target" type="constant" length="B" value=" "/>
  <!-- SP separator in the request line. -->
  <field name="http-version" type="constant" length="B" value="HTTP/1.1"/>
  <!-- HTTP version from the sample request. -->
  <field name="request-line-crlf" type="constant" length="B" value="&#13;&#10;"/>
  <!-- CRLF framing that terminates the request line. -->
  <field name="host-field-name" type="constant" length="B" value="Host"/>
  <!-- Host header field name. -->
  <field name="host-field-delimiter" type="constant" length="B" value=": "/>
  <!-- Colon and optional space between the header name and value. -->
  <field name="host-value" type="variable" length="undefined" value="daap.example.com"/>
  <!-- Target server authority; sample value from section 5.1. -->
  <field name="host-line-crlf" type="constant" length="B" value="&#13;&#10;"/>
  <!-- CRLF ending the Host header line. -->
  <field name="accept-field-name" type="constant" length="B" value="Accept"/>
  <!-- Accept header field name. -->
  <field name="accept-field-delimiter" type="constant" length="B" value=": "/>
  <!-- Colon and optional space between the header name and value. -->
  <field name="accept-value" type="variable" length="undefined" value="*/*"/>
  <!-- Media range accepted by the client; sample value is */*. -->
  <field name="accept-line-crlf" type="constant" length="B" value="&#13;&#10;"/>
  <!-- CRLF ending the Accept header line. -->
  <field name="user-agent-field-name" type="constant" length="B" value="User-Agent"/>
  <!-- User-Agent header field name. -->
  <field name="user-agent-field-delimiter" type="constant" length="B" value=": "/>
  <!-- Colon and optional space between the header name and value. -->
  <field name="user-agent-value" type="variable" length="undefined" value="iTunes/4.0 (Macintosh; N; PPC)"/>
  <!-- Client product token and comment; sample value from section 5.1. -->
  <field name="user-agent-line-crlf" type="constant" length="B" value="&#13;&#10;"/>
  <!-- CRLF ending the User-Agent header line. -->
  <field name="client-daap-version-field-name" type="constant" length="B" value="Client-DAAP-Version"/>
  <!-- DAAP-specific client version header. -->
  <field name="client-daap-version-field-delimiter" type="constant" length="B" value=": "/>
  <!-- Colon and optional space between the header name and value. -->
  <field name="client-daap-version-value" type="constant" length="B" value="1.0"/>
  <!-- DAAP protocol version supplied by iTunes; sample value is 1.0. -->
  <field name="client-daap-version-line-crlf" type="constant" length="B" value="&#13;&#10;"/>
  <!-- CRLF ending the Client-DAAP-Version header line. -->
  <field name="accept-encoding-field-name" type="constant" length="B" value="Accept-Encoding"/>
  <!-- Accept-Encoding header field name. -->
  <field name="accept-encoding-field-delimiter" type="constant" length="B" value=": "/>
  <!-- Colon and optional space between the header name and value. -->
  <field name="accept-encoding-value" type="variable" length="undefined" value="gzip"/>
  <!-- Content coding token; sample is gzip, and section 2 says most DAAP requests use gzip. -->
  <field name="accept-encoding-line-crlf" type="constant" length="B" value="&#13;&#10;"/>
  <!-- CRLF ending the Accept-Encoding header line. -->
  <field name="end-of-headers" type="constant" length="B" value="&#13;&#10;"/>
  <!-- Empty line after the header fields; server-info has no request body. -->
</message>
  <message name="login" direction="request">
  <field name="request-line" type="constant" length="undefined" value="GET /login HTTP/1.1&#13;&#10;">
    <!-- Complete HTTP request line: method GET, request-target /login, HTTP/1.1, CRLF framing. -->
  </field>
  <field name="Host" type="variable" length="undefined" value="Host: authority&#13;&#10;">
    <!-- HTTP/1.1 Host header; authority is the DAAP server host[:port]. -->
  </field>
  <field name="Accept" type="constant" length="undefined" value="Accept: */*&#13;&#10;">
    <!-- Generic Accept header shown in the DAAP sample request. -->
  </field>
  <field name="User-Agent" type="variable" length="undefined" value="User-Agent: iTunes/4.0 (Macintosh; N; PPC)&#13;&#10;">
    <!-- Client identifier; sample iTunes/4.0 User-Agent, not a DAAP protocol constant. -->
  </field>
  <field name="Client-DAAP-Version" type="constant" length="undefined" value="Client-DAAP-Version: 1.0&#13;&#10;">
    <!-- The only DAAP-specific extra header; iTunes sends DAAP version 1.0. -->
  </field>
  <field name="Accept-Encoding" type="constant" length="undefined" value="Accept-Encoding: gzip&#13;&#10;">
    <!-- Client advertises gzip support; server responses may use gzip content encoding. -->
  </field>
  <field name="empty-line" type="constant" length="undefined" value="&#13;&#10;">
    <!-- Empty CRLF line terminates the header section; the login GET has no request body. -->
  </field>
</message>
</ir>
