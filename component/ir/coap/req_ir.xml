<?xml version='1.0' encoding='UTF-8' standalone='yes'?>
<ir>
  <message name="Ping">
    <!-- Ping message used in CoAP signaling (RFC 8323) to verify liveness or request custody acknowledgment -->
    <field name="Version" type="constant" length="2b" value="0"/>
    <!-- Protocol version (00 for RFC 8323) -->
    <field name="Type" type="constant" length="2b" value="0"/>
    <!-- Message type (0 for signaling) -->
    <field name="TokenLength" type="variable" length="4b" value="0..8"/>
    <!-- Length of the Token field in bytes (0-8) -->
    <field name="Code" type="constant" length="1B" value="0xe2"/>
    <!-- CoAP code 7.02 (Ping) -->
    <field name="Token" type="variable" length="undefined" value="any sequence of TokenLength bytes"/>
    <!-- Token used to match Ping with Pong response; in the example, one byte 0x42 -->
    <!-- Optional elective Custody Option (empty option, no data) may follow -->
</message>
  <message name="DELETE">
    <!-- CoAP DELETE request message, used to delete a resource identified by a URI template like {+location} -->

    <field name="Version" type="constant" length="2b" value="01"/>
    <!-- CoAP protocol version, currently always 01 -->

    <field name="Type" type="variable" length="2b" value="0 (Confirmable) or 1 (Non-confirmable)"/>
    <!-- Message type: 0 for Confirmable, 1 for Non-confirmable; chosen by the client -->

    <field name="TokenLength" type="variable" length="4b" value="0 to 8"/>
    <!-- Length of the Token field in bytes (0 through 8) -->

    <field name="Code" type="constant" length="1B" value="0x04"/>
    <!-- CoAP method code 0.04, indicating DELETE (class 0, detail 4) -->

    <field name="MessageID" type="variable" length="2B" value="0 to 65535"/>
    <!-- Message ID used for matching requests and responses -->

    <field name="Token" type="variable" length="undefined" value="binary bytes, length given by TokenLength"/>
    <!-- Token for correlating a response with the request; may be empty -->

    <field name="Options" type="variable" length="undefined" value="TLV-encoded options per CoAP spec (e.g., Uri-Path, Uri-Host, etc.)"/>
    <!-- Options carrying metadata such as the target URI (e.g., /coap-group/12) and other options. Options are encoded as Type-Length-Value and are terminated by a 0xFF payload marker if a payload follows -->

    <field name="PayloadMarker" type="constant" length="1B" value="0xFF" mandatory="false">
    <!-- Payload marker byte; present only if a payload is included after the options (typical for DELETE requests, payload is usually absent) -->
    </field>

    <field name="Payload" type="variable" length="undefined" value="application-specific data (optional)">
    <!-- Optional payload of the request; no defined semantics for DELETE in the base CoAP specification -->
    </field>
</message>
  <message name="GET">
    <!-- CoAP GET request message used to retrieve a representation of a resource. Supports optional Observe and Block2 options. -->

    <field name="VersionTypeTokenLen" type="variable" length="1B" value="0x40-0x4F, 0x50-0x5F? etc."/>
    <!-- First byte: top 2 bits = Version (01), next 2 bits = Type (00-11), low 4 bits = Token Length (0-8). Example: 0x41 = Version 1, Type 00 (Confirmable), Token Length 1. -->

    <field name="Code" type="constant" length="1B" value="0x01"/>
    <!-- CoAP method code for GET (0.01). -->

    <field name="MessageID" type="variable" length="2B" value="0x0000-0xFFFF"/>
    <!-- Message identifier for matching requests/responses. -->

    <field name="Token" type="variable" length="undefined" value="any byte sequence (0-8 bytes)"/>
    <!-- Token for request/response correlation. Length determined by Token Length field in first byte. -->

    <field name="Options" type="variable" length="undefined" value="encoded CoAP options"/>
    <!-- Sequence of options in delta-length-value format, sorted by option number. Common options for GET: Observe (6), Uri-Path (11), Block2 (23). Each option begins with a variable-length delta (difference from previous option number) and length, followed by the option value. -->

    <field name="PayloadMarker" type="constant" length="1B" value="0xFF" optional="true"/>
    <!-- Optional payload marker (0xFF) indicating start of payload, present only if payload exists. -->

    <field name="Payload" type="variable" length="undefined" value="any byte sequence" optional="true"/>
    <!-- Payload (empty for most GET requests; may contain query parameters or body for extended methods). -->
</message>
  <message name="FETCH">
    <!-- CoAP FETCH request message (RFC 8132). 
         The FETCH method is used to retrieve a subset of a resource's 
         representation based on a query payload. It is idempotent and safe. -->

    <field name="Version" type="constant" length="2b" value="01"/>
    <!-- CoAP version bits (always 01). -->

    <field name="Type" type="variable" length="2b" value="0-3"/>
    <!-- Message type: 0=CON, 1=NON, 2=ACK, 3=RST. -->

    <field name="TokenLength" type="variable" length="4b" value="0-8"/>
    <!-- Length of the Token field in bytes (0..8). -->

    <field name="Code" type="constant" length="1B" value="0x05"/>
    <!-- CoAP method code for FETCH (0.05). -->

    <field name="MessageID" type="variable" length="2B" value="0-65535"/>
    <!-- Message ID used to match requests and responses. -->

    <field name="Token" type="variable" length="undefined" value="byte sequence (length given by TokenLength)"/>
    <!-- Request token; used to correlate a response. May be empty. -->

    <field name="Options" type="variable" length="undefined" value="sequence of option entries (Type-Length-Value)"/>
    <!-- Zero or more CoAP options. Typical options for FETCH:
         Content-Format (12), Accept (17), Uri-Path (11), 
         Q-Block1 (19), Q-Block2 (20), Observe (6), etc.
         Each option is encoded as per RFC 7252. -->

    <field name="PayloadMarker" type="constant" length="1B" value="0xFF"/>
    <!-- One-byte payload marker (0xFF) present only if payload length > 0.
         Indicates the start of the payload. -->

    <field name="Payload" type="variable" length="undefined" value="byte sequence"/>
    <!-- Payload containing the search query (e.g., JSON array of map keys).
         Media type is specified by the Content-Format option. -->
</message>
  <message name="PATCH">
    <!-- CoAP PATCH request method (code 0.06). Used to apply a partial modification to a resource. Non-idempotent. Payload contains patch instructions in a specified content-format (e.g., application/json-patch+json or application/merge-patch+json). Options include Uri-Path, Content-Format, and optionally Accept. -->

    <field name="Version" type="constant" length="2b" value="01"/>
    <!-- CoAP version number: currently fixed to 01 (binary) -->

    <field name="Type" type="variable" length="2b" value="0 (Confirmable), 1 (Non-confirmable), 2 (Acknowledgement), 3 (Reset)"/>
    <!-- Message type; for a request, typically Confirmable (0) or Non-confirmable (1) -->

    <field name="TokenLength" type="variable" length="4b" value="0..8"/>
    <!-- Length of the Token field in bytes (0 to 8) -->

    <field name="Code" type="constant" length="1B" value="0x06"/>
    <!-- CoAP method code for PATCH: 0.06 (class=0, detail=6) -->

    <field name="MessageID" type="variable" length="2B" value="0..65535"/>
    <!-- Message identifier used for duplicate detection and matching responses -->

    <field name="Token" type="variable" length="TokenLength" value="any 8-bit bytes"/>
    <!-- Request token, used to correlate request and response; length determined by TokenLength field -->

    <field name="Options" type="variable" length="undefined" value="sequence of (OptionDelta, OptionLength, OptionValue) per RFC 7252"/>
    <!-- CoAP options (e.g., Uri-Path, Content-Format). Options are encoded as Delta-Length-Value tuples. The options block extends until the Payload Marker (0xFF) or end of message if no payload. -->

    <field name="PayloadMarker" type="constant" length="1B" value="0xFF"/>
    <!-- One-byte payload marker (0xFF) indicating start of payload; present only if payload exists -->

    <field name="Payload" type="variable" length="undefined" value="any 8-bit bytes"/>
    <!-- Body of the PATCH request containing the patch document (e.g., JSON Patch or JSON Merge Patch) in a format indicated by the Content-Format option -->
</message>
  <message name="iPATCH">
    <!-- CoAP iPATCH request message: idempotent, non-safe method (code 0.07).
         Used to apply a partial modification to a resource, identical to PATCH but idempotent. -->

    <field name="VersionTypeTKL" type="constant" length="1B" value="0b01??????"/>
    <!-- First byte: Version (2 bits, must be 01 for CoAP), Type (2 bits: Confirmable=0, Non-confirmable=1, etc.),
         Token Length (4 bits, 0-8). Value shown as placeholder; actual bits set per message. -->

    <field name="Code" type="constant" length="1B" value="0x07"/>
    <!-- iPATCH method code: class 0 (request), detail 7. -->

    <field name="MessageID" type="variable" length="2B" value="0-65535"/>
    <!-- Message identifier used for matching requests/responses and for deduplication. -->

    <field name="Token" type="variable" length="0-8B" value="any bytes"/>
    <!-- Token to correlate request with response; length determined by Token Length field. -->

    <field name="Options" type="variable" length="undefined" value="TLV encoded CoAP options"/>
    <!-- Variable-length sequence of options (e.g., Uri-Path, Content-Format). 
         Each option is encoded as Type-Length-Value. -->

    <field name="PayloadMarker" type="constant" length="1B" value="0xFF"/>
    <!-- Payload marker byte present only if payload length > 0. Separates options from payload. -->

    <field name="Payload" type="variable" length="undefined" value="any bytes (e.g., JSON Patch document)"/>
    <!-- Message payload, typically a JSON Patch or Merge Patch document, 
         content format indicated by Content-Format option. -->
</message>
  <message name="PUT">
    <!-- CoAP PUT request message for updating a resource -->
    <field name="Version" type="constant" length="2b" value="0x1"/>
    <!-- CoAP version number (currently always 1) -->
    <field name="Type" type="variable" length="2b" value="0-3"/>
    <!-- Message type: 0=CON, 1=NON, 2=ACK, 3=RST -->
    <field name="TokenLength" type="variable" length="4b" value="0-8"/>
    <!-- Length of the Token field in bytes (0 to 8) -->
    <field name="Code" type="constant" length="1B" value="0x03"/>
    <!-- CoAP method code for PUT (0.03) -->
    <field name="MessageID" type="variable" length="2B" value="0-65535"/>
    <!-- 16-bit message identifier for matching requests/responses and detecting duplicates -->
    <field name="Token" type="variable" length="undefined" value="0-255 per byte"/>
    <!-- Token bytes; length determined by TokenLength field. Used to correlate request/response. -->
    <field name="Options" type="variable" length="undefined" value="TLV encoded options"/>
    <!-- Sequence of CoAP options, each with option delta, option length, and option value. Examples: Uri-Path, Content-Format, Block1, etc. -->
    <field name="PayloadMarker" type="constant" length="1B" value="0xFF"/>
    <!-- One-byte marker indicating start of payload (0xFF). Present only if payload follows. -->
    <field name="Payload" type="variable" length="undefined" value="opaque bytes"/>
    <!-- Payload data (e.g., resource representation). Length inferred from datagram or block-wise transfer. -->
</message>
  <message name="Pong">
    <!-- CoAP over TCP/TLS/WebSockets Pong signaling message (Code 7.03). 
         Sent in response to a Ping, optionally including a Custody Option to 
         indicate processing of prior messages. The header consists of a 1-byte 
         field encoding the length of options and the token length, followed by 
         a code byte, a token, and options. -->

    <field name="Length" type="variable" length="4b" value="0-12 (basic) or extended"/>
    <!-- High nibble of first byte: length of options and payload (in bytes). 
         In a Pong, payload is absent, so this is the length of the options block. 
         If 13 or 14, additional bytes follow for extended length (not modeled here). 
         Value is 0 for no options. -->

    <field name="TokenLength" type="variable" length="4b" value="0-8"/>
    <!-- Low nibble of first byte: length of the Token field in bytes. 
         Valid range 0-8. The Token is echoed from the corresponding Ping message. -->

    <field name="Code" type="constant" length="1B" value="0xe3"/>
    <!-- CoAP signaling code for Pong (7.03). Distinguishes this as a Pong message. -->

    <field name="Token" type="variable" length="undefined" value="0x00-0xFF (arbitrary)"/>
    <!-- Echoed token from the Ping message. Actual length is given by TokenLength field. 
         If TokenLength is 0, this field is absent. -->

    <field name="Options" type="variable" length="undefined" value="CoAP option encoding (delta+length+value)"/>
    <!-- Block of CoAP options. Actual length in bytes is given by the Length field. 
         For a Pong, the only defined option is the elective Custody Option (option number 2, 
         empty value). If present, the receiver should interpret it as an indication that 
         all prior request/response messages have been processed. Other options are not 
         defined for Pong. 
         The options are encoded per RFC 8323 section 5.3 using delta and length fields. -->
</message>
  <message name="POST">
    <!-- CoAP POST request message used to create or update resources -->
    <field name="Version" type="constant" length="2b" value="1"/>
    <!-- CoAP version number (currently 1) -->
    <field name="Type" type="variable" length="2b" value="0-3"/>
    <!-- Message type: 0=CON, 1=NON, 2=ACK, 3=RST. For POST request typically CON or NON -->
    <field name="TokenLength" type="variable" length="4b" value="0-15"/>
    <!-- Length of the Token field in bytes (valid range 0-8, values 9-15 reserved) -->
    <field name="Code" type="constant" length="1B" value="0x02"/>
    <!-- CoAP method code for POST (0.02) -->
    <field name="MessageID" type="variable" length="2B" value="0-65535"/>
    <!-- Message ID used to correlate requests and responses -->
    <field name="Token" type="variable" length="undefined" value="arbitrary bytes"/>
    <!-- Token used to match a response to the request; length is given by TokenLength field -->
    <field name="Options" type="variable" length="undefined" value="encoded options"/>
    <!-- Sequence of CoAP options (e.g., Uri-Path, Content-Type) encoded as per RFC 7252. Each option consists of option delta, option length, and option value. -->
    <field name="PayloadMarker" type="constant" length="1B" value="0xFF"/>
    <!-- Payload marker byte (0xFF) indicating start of payload. Present only if payload length > 0. -->
    <field name="Payload" type="variable" length="undefined" value="arbitrary bytes"/>
    <!-- Payload data of the POST request. Content depends on the resource and content format. -->
</message>
</ir>
