<?xml version='1.0' encoding='UTF-8' standalone='yes'?>
<ir>
  <message name="CoAPResponse">
    <!-- CoAP response message as defined in RFC 7252. Carries response codes, options, and payload from server to client. -->

    <field name="Version" type="constant" length="2b" value="01"/>
    <!-- CoAP version (currently always 01 binary) -->

    <field name="Type" type="variable" length="2b" value="0-3"/>
    <!-- Message type: 0=Confirmable, 1=Non-confirmable, 2=Acknowledgement, 3=Reset. For responses typically 0 or 1. -->

    <field name="TokenLength" type="variable" length="4b" value="0-8"/>
    <!-- Length of the Token field in bytes (0-8). Indicates number of bytes in the Token field. -->

    <field name="Code" type="variable" length="1B" value="0.00-5.31 (encoded as 8-bit)"/>
    <!-- Response code (e.g., 2.05 Content encoded as 0x45; class byte in upper 3 bits, detail in lower 5 bits). Covers success, client error, server error, etc. -->

    <field name="MessageID" type="variable" length="2B" value="0-65535"/>
    <!-- 16-bit message identifier used for matching requests and responses (Acknowledgements, Resets, and duplicate detection). -->

    <field name="Token" type="variable" length="TokenLength bytes" value="arbitrary bytes (up to 8)"/>
    <!-- Token bytes used to correlate a request with a response. Length determined by TokenLength field. -->

    <field name="Options" type="variable" length="undefined" value="sequence of options (see RFC 7252)"/>
    <!-- Zero or more options in Type-Length-Value format. Each option has an option number delta, length, and value. Options are delta-encoded. Terminated by payload marker or end of message. -->

    <field name="PayloadMarker" type="constant" length="1B" value="0xFF"/>
    <!-- One-byte payload marker (0xFF) indicating that payload follows. Present only if payload length > 0. -->

    <field name="Payload" type="variable" length="remaining bytes" value="application-specific data"/>
    <!-- Payload content following the payload marker. Format determined by Content-Format option. May be empty. -->

</message>
</ir>
