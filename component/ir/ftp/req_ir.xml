<?xml version='1.0' encoding='UTF-8' standalone='yes'?>
<ir>
  <message name="USER">
    <!-- Command to specify the user name for FTP login, typically the first command after control connection establishment -->

    <field name="CommandCode" type="constant" length="4B" value="USER"/>
    <!-- Command code indicating the USER command; case-insensitive but represented here as uppercase -->

    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Single space separating command code and argument; one or more spaces are allowed per RFC 959 -->

    <field name="Username" type="variable" length="undefined" value="any of the 128 ASCII characters except CR (0x0D) and LF (0x0A)"/>
    <!-- Telnet string identifying the user; the argument field for the USER command -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed (CRLF) sequence terminating the command line -->
</message>
  <message name="PROT">
    <!-- Command to set the data channel protection level (Clear, Safe, Confidential, or Private) as defined in RFC 2228 -->

    <field name="CommandCode" type="constant" length="4B" value="PROT"/>
    <!-- Command code for the PROT command, indicating a data channel protection level request -->

    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Space character separating the command code from its argument -->

    <field name="ProtectionLevel" type="variable" length="1B" value="C | S | E | P"/>
    <!-- One-character code specifying the protection level: C=Clear, S=Safe, E=Confidential, P=Private -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed indicating the end of the command line (NVT-ASCII) -->
</message>
  <message name="ALLO">
    <!-- Command to allocate sufficient storage on the server for a file to be transferred -->

    <field name="CommandCode" type="constant" length="4B" value="ALLO"/>
    <!-- Command code "ALLO" (case‑insensitive) indicating an allocate request -->

    <field name="Separator1" type="constant" length="1B" value="0x20"/>
    <!-- Space character (ASCII 0x20) separating the command code from the first argument -->

    <field name="FirstArgument" type="variable" length="undefined" value="decimal digits 0-9"/>
    <!-- Required decimal integer representing the number of bytes (logical byte size) of storage to reserve for the file -->

    <field name="OptionalSeparator" type="constant" length="3B" value="0x20 0x52 0x20"/>
    <!-- Optional sequence <SP> R <SP> (Space, 'R', Space) that introduces the second argument. Present only if the server also requires a maximum record or page size. -->

    <field name="SecondArgument" type="variable" length="undefined" value="decimal digits 0-9"/>
    <!-- Optional decimal integer representing the maximum record or page size (in logical bytes). Included only when the previous optional separator is present. -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed (CRLF) marking the end of the ALLO command -->
</message>
  <message name="STOR">
    <!-- Command to store (upload) a file to the FTP server. The server-DTP accepts the data transferred via the data connection and stores it as a file at the server site. -->

    <field name="CommandCode" type="constant" length="3B" value="STOR"/>
    <!-- Command code indicating a STORE request. Case-insensitive; typically transmitted as uppercase. -->

    <field name="Whitespace" type="variable" length="undefined" value="0x20"/>
    <!-- One or more space characters (ASCII 0x20) separating the command code from the pathname argument. -->

    <field name="Pathname" type="variable" length="undefined" value="ASCII 0x01..0x09,0x0B..0x0C,0x0E..0x7F"/>
    <!-- Pathname of the file to be stored at the server site. May include any ASCII character except CR (0x0D) and LF (0x0A). Typically a string of printable characters. -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Telnet end-of-line sequence: Carriage Return (0x0D) followed by Line Feed (0x0A). Terminates the command. -->
</message>
  <message name="ENC">
    <!-- Privacy protected command (ENC) - used to send a command protected with both integrity and confidentiality via base64 encoding, as part of FTP Security Extensions (RFC 2228) -->

    <field name="CommandCode" type="constant" length="3B" value="ENC"/>
    <!-- Command code indicating a privacy protected command (case-insensitive but typically uppercase) -->

    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Space separator between command code and argument; RFC allows one or more spaces, but one space is typical -->

    <field name="Base64Data" type="variable" length="undefined" value="Base64 encoded data (A-Z, a-z, 0-9, +, /, =)"/>
    <!-- Base64 encoded message produced by a security mechanism specific message integrity and confidentiality procedure. The encoding uses the same set as RFC 1421 Section 4.3.2.4, excluding line breaks. The length is variable and may be arbitrarily long. -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return (0x0D) and Line Feed (0x0A) indicating end of the command; Telnet NVT-ASCII line termination -->
</message>
  <message name="PASV">
    <!-- Command to request the server enter passive mode and listen on a data port -->
    <field name="CommandCode" type="constant" length="3B" value="PASV"/>
    <!-- Command code indicating a request for passive mode; telnet ASCII characters -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed indicating end of the command; no argument field required -->
</message>
  <message name="SYST">
    <!-- Command to query the server's operating system type. The server responds with a system name from the Assigned Numbers document. -->

    <field name="CommandCode" type="constant" length="4B" value="SYST"/>
    <!-- Command code indicating the system type request. It is case-insensitive but conventionally sent uppercase. -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return (0x0D) and Line Feed (0x0A) marking the end of the command (Telnet NVT-ASCII end-of-line). -->
</message>
  <message name="CDUP">
    <!-- Command to change to the parent directory on the FTP server. This is a special case of CWD and takes no argument. The reply codes are identical to those of CWD. -->

    <field name="CommandCode" type="constant" length="4B" value="CDUP"/>
    <!-- Command code for Change to Parent Directory. Uppercase representation used as per convention; case is ignored by the server. -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed terminating the command. No whitespace or argument field is present for CDUP. -->
</message>
  <message name="FEAT">
    <!-- FEAT command sent by client to request list of server extensions -->
    <field name="CommandCode" type="constant" length="4B" value="FEAT"/>
    <!-- Command code for FEAT; case-insensitive but typically sent in uppercase -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed indicating end of the command -->
</message>
  <message name="ABOR">
    <!-- Command to abort the previous FTP service command and any associated data transfer -->

    <field name="CommandCode" type="constant" length="4B" value="ABOR"/>
    <!-- Command code indicating an abort request; alphabetic characters, case-insensitive -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed (CRLF) sequence terminating the command; for NVT-ASCII control connection -->
</message>
  <message name="MDTM">
    <!-- Command to obtain the last modification time of a file (query form). For the set variant, a time-val is inserted between the command code and the pathname. -->
    <field name="CommandCode" type="constant" length="4B" value="MDTM"/>
    <!-- Command code indicating MDTM; case-insensitive, canonical uppercase -->
    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Space character separating command code and argument -->
    <field name="Pathname" type="variable" length="undefined" value="ASCII characters except CR and LF"/>
    <!-- Pathname of the file whose modification time is requested; may include any printable and non-printable ASCII characters except carriage return and line feed -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed terminating the command -->
</message>
  <message name="STRU">
    <!-- Command to specify file structure (File, Record, or Page) for data transfer -->

    <field name="CommandCode" type="constant" length="3B" value="STRU"/>
    <!-- Command code indicating file structure specification -->

    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Space character separating command code from argument -->

    <field name="StructureCode" type="variable" length="1B" value="F | R | P"/>
    <!-- Single Telnet character code specifying the file structure: F (File), R (Record), P (Page). Default is File. -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed terminating the command -->
</message>
  <message name="STAT">
    <!-- FTP STATUS command: requests server status information over the control connection. May include an optional pathname argument. When sent during a file transfer, the server responds with the status of the operation in progress; otherwise, it returns general status or file attributes if a pathname is given. -->
    <field name="CommandCode" type="constant" length="4B" value="STAT"/>
    <!-- Four-character command code indicating a status request. Case-insensitive; typically transmitted as uppercase ASCII letters. -->
    <field name="OptionalArgument" type="variable" length="undefined" value="If present: a single space (0x20) followed by a pathname string composed of any ASCII characters except CR and LF (codes 0x0D and 0x0A). If absent, this field has zero length."/>
    <!-- Optional argument consisting of a separator space and a pathname. The space is included only when an argument is provided. When absent, the command is followed directly by the end-of-line sequence. The pathname may be partial; the server interprets it as a file or directory specification. -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Telnet end-of-line code: Carriage Return (0x0D) followed by Line Feed (0x0A). Marks the end of the command. The server must not process the command until this sequence is received. -->
</message>
  <message name="EPSV">
    <!-- Command to request the server to enter extended passive mode,
         indicating it will listen on a data port and wait for a connection.
         The command takes an optional argument: either a network protocol
         number (decimal integer) or the literal string "ALL". -->

    <field name="CommandCode" type="constant" length="4B" value="EPSV"/>
    <!-- Command code for Extended Passive Mode, always uppercase "EPSV" -->

    <field name="Whitespace" type="variable" length="undefined" value="0x20 (one or more)"/>
    <!-- Space character(s) separating command code and argument.
         This field is present only when an argument is supplied.
         If no argument is given, this field is omitted entirely. -->

    <field name="Argument" type="variable" length="undefined" value="decimal integer (1-255) or literal 'ALL'"/>
    <!-- Optional argument to EPSV. When absent, no argument is sent.
         A decimal integer indicates the desired network protocol (e.g., 1 for IPv4, 2 for IPv6).
         The literal string "ALL" instructs the server to reject all data connection setup commands other than EPSV. -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed (CRLF) terminating the command line.
         In NVT-ASCII representation, this marks the end of the command. -->
</message>
  <message name="QUIT">
    <!-- Command to terminate the current user session and close the control connection (if no file transfer is in progress) -->

    <field name="CommandCode" type="constant" length="3B" value="QUIT"/>
    <!-- The command code that indicates the logout request; no argument follows -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed characters (CRLF) marking the end of the command in NVT-ASCII -->
</message>
  <message name="PASS">
    <!-- Command to provide user password for login, must follow USER command -->
    <field name="CommandCode" type="constant" length="3B" value="PASS"/>
    <!-- Command code for Password command -->
    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Space separator between command and argument (one space typical) -->
    <field name="Password" type="variable" length="undefined" value="any ASCII character except CR (0x0D) and LF (0x0A)"/>
    <!-- The user's password as a Telnet string; may contain any printable or non-printable ASCII except CR and LF -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed terminating the command -->
</message>
  <message name="ACCT">
    <!-- Command to specify the user's account for access control. May be required for login or for specific operations like storing files. -->
    <field name="CommandCode" type="constant" length="4B" value="ACCT"/>
    <!-- Command code indicating the ACCOUNT command. Case-insensitive; uppercase typical. -->
    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Space character separating command code and argument. One or more spaces allowed, but one is typical. -->
    <field name="AccountInformation" type="variable" length="undefined" value="ASCII characters (codes 0-127) except CR (0x0D) and LF (0x0A)"/>
    <!-- The account identifier as a Telnet string. Variable length; may be empty or omitted? According to RFC, argument field is present but can be empty? The syntax shows <account-information> = <string>, and <string> can be empty? BNF: <string> ::= <char> | <char><string> implies one or more chars. However, some implementations may allow empty? We assume a non-empty string as per BNF, but optionality not explicitly stated. -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed indicating end of the command. For NVT-ASCII control connection. -->
</message>
  <message name="AUTH">
    <!-- Command to initiate security mechanism negotiation in FTP. The client proposes a security mechanism; the server responds with acceptance or further data required. -->

    <field name="CommandCode" type="constant" length="4B" value="AUTH"/>
    <!-- Command code indicating authentication/security mechanism setup. Case-insensitive, transmitted as uppercase. -->

    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Single space character (ASCII SP) separating command code from the mechanism name. -->

    <field name="MechanismName" type="variable" length="undefined" value="ASCII characters 0-127 except CR (0x0D) and LF (0x0A)"/>
    <!-- The argument identifying the security mechanism. Case-insensitive; must be registered with IANA or begin with &quot;X-&quot; for local use. Length variable, terminated by CRLF. -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed (CRLF) marking the end of the command line in NVT-ASCII representation. -->
</message>
  <message name="MLSD">
    <!-- Command to obtain a machine-readable directory listing of a directory on the FTP server; part of FTP extensions (RFC 3659). The argument is optional; if omitted, the current working directory is listed. -->
    <field name="CommandCode" type="constant" length="4B" value="MLSD"/>
    <!-- Command code for Machine-accessible List of Selected Directory. Case-insensitive, but typically sent as "MLSD". -->
    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Space character (SP) separating the command code from the pathname argument. Present only if a pathname is provided. -->
    <field name="Pathname" type="variable" length="undefined" value="0x01-0x09,0x0B-0x0C,0x0E-0x7F (ASCII printable and control except CR, LF)"/>
    <!-- Optional pathname of a directory (or file for MLST, but for MLSD it must be a directory). If included, the server lists the contents of that directory. If omitted, the server lists the current working directory. The field is variable-length, terminated by the CRLF. Full pathname syntax follows NVT-ASCII and UTF-8 rules. -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return (CR) followed by Line Feed (LF) marking the end of the FTP command line. -->
</message>
  <message name="PORT">
    <!-- Command to specify data port (host and TCP port) for data connection; argument is host address and port as six decimal numbers separated by commas -->
    <field name="CommandCode" type="constant" length="3B" value="PORT"/>
    <!-- Command code for Data Port; case-insensitive, typically uppercase -->
    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Space character separating command code and argument -->
    <field name="HostOctet1" type="variable" length="undefined" value="decimal integer 0-255"/>
    <!-- High‑order 8 bits of the 32‑bit internet host address (first octet) -->
    <field name="Comma1" type="constant" length="1B" value="0x2C"/>
    <!-- Comma separating host octets -->
    <field name="HostOctet2" type="variable" length="undefined" value="decimal integer 0-255"/>
    <!-- Second octet of host address -->
    <field name="Comma2" type="constant" length="1B" value="0x2C"/>
    <field name="HostOctet3" type="variable" length="undefined" value="decimal integer 0-255"/>
    <!-- Third octet of host address -->
    <field name="Comma3" type="constant" length="1B" value="0x2C"/>
    <field name="HostOctet4" type="variable" length="undefined" value="decimal integer 0-255"/>
    <!-- Fourth (low‑order) octet of host address -->
    <field name="Comma4" type="constant" length="1B" value="0x2C"/>
    <field name="PortOctet1" type="variable" length="undefined" value="decimal integer 0-255"/>
    <!-- High‑order 8 bits of the 16‑bit TCP port address -->
    <field name="Comma5" type="constant" length="1B" value="0x2C"/>
    <field name="PortOctet2" type="variable" length="undefined" value="decimal integer 0-255"/>
    <!-- Low‑order 8 bits of the TCP port address; actual port = PortOctet1*256 + PortOctet2 -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed (CRLF) indicating end of the command -->
</message>
  <message name="MKD">
    <!-- Command to create a directory on the FTP server -->
    <field name="CommandCode" type="constant" length="3B" value="MKD"/>
    <!-- The command code for Make Directory, case-insensitive; typically transmitted as uppercase -->
    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Space character separating command code and pathname argument; RFC allows one or more spaces, but one is typical and minimal -->
    <field name="Pathname" type="variable" length="undefined" value="ASCII characters excluding CR (0x0D) and LF (0x0A)"/>
    <!-- Pathname of directory to create; can be absolute or relative. Length variable; terminated by the end-of-line sequence -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return (0x0D) and Line Feed (0x0A) marking the end of the command (NVT-ASCII Telnet end-of-line) -->
</message>
  <message name="SIZE">
    <!-- Command to retrieve the transfer size of a file from the FTP server, as defined in RFC 3659 -->

    <field name="CommandCode" type="constant" length="4B" value="SIZE"/>
    <!-- Command code indicating the SIZE request (case-insensitive, typically sent uppercase); 4 ASCII characters -->

    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Space character (ASCII 32) separating the command code from the pathname argument -->

    <field name="Pathname" type="variable" length="undefined" value="ASCII 0-127 except CR (0x0D) and LF (0x0A)"/>
    <!-- Pathname of the file whose size is requested; variable length string of any ASCII characters except carriage return and line feed; ends at the CRLF terminator -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return (0x0D) followed by Line Feed (0x0A) marking the end of the command line -->
</message>
  <message name="MLST">
    <!-- Machine-parseable listing of a single file or directory (MLST command) -->
    <field name="CommandCode" type="constant" length="4B" value="MLST"/>
    <!-- Command code indicating a request for machine-processable facts about a file or directory. Case-insensitive, typically uppercase. -->
    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Single space separator. Present only if a pathname argument is provided. Omitted when no argument is given. -->
    <field name="Pathname" type="variable" length="undefined" value="UTF-8 encoded string or raw string (any characters except CR and LF)"/>
    <!-- Optional pathname of the file or directory to list. If omitted, the current working directory is listed. End of pathname is indicated by the terminating CRLF. -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed indicating the end of the command. -->
</message>
  <message name="NLST">
    <!-- Request to obtain a directory listing of file names (name list) from the server -->

    <field name="CommandCode" type="constant" length="4B" value="NLST"/>
    <!-- Command code for Name List, indicating a request for a list of file names (no other details) -->

    <field name="Separator" type="variable" length="undefined" value="0x20 (zero or more spaces)"/>
    <!-- One or more space characters separating command code from the pathname argument; omitted if no pathname is provided -->

    <field name="Pathname" type="variable" length="undefined" value="ASCII characters excluding CR and LF; may be empty (null argument)"/>
    <!-- Optional directory pathname; if absent, the current directory is assumed. The pathname may also be a UTF-8 encoded string per RFC 3659 -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed characters terminating the command (Telnet NVT end-of-line) -->
</message>
  <message name="PWD">
    <!-- Command to request the current working directory path from the FTP server -->

    <field name="CommandCode" type="constant" length="3B" value="PWD"/>
    <!-- Command code indicating "Print Working Directory" (case-insensitive but typically uppercase) -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed (CRLF) terminating the command, as per Telnet NVT-ASCII convention -->
</message>
  <message name="SMNT">
    <!-- Command to mount a different file system directory structure without altering login or accounting information -->

    <field name="CommandCode" type="constant" length="4B" value="SMNT"/>
    <!-- ASCII characters "SMNT" as the command code (case-insensitive, but typically uppercase) -->

    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Space character (0x20) separating command code and argument; per RFC, one or more spaces allowed, but a single space is typical -->

    <field name="Pathname" type="variable" length="undefined" value="ASCII characters except CR and LF"/>
    <!-- Pathname specifying the file system directory or group designator to be mounted; variable length, terminated by CRLF -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return (0x0D) and Line Feed (0x0A) marking the end of the command line -->
</message>
  <message name="APPE">
    <!-- Append (with create) command: causes server to accept data and append to specified file, or create if not exists -->
    <field name="CommandCode" type="constant" length="4B" value="APPE"/>
    <!-- Command code indicating the APPEND operation; case-insensitive per RFC 959 -->
    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Space character separating command code and pathname argument -->
    <field name="Pathname" type="variable" length="undefined" value="ASCII printable characters excluding CR and LF"/>
    <!-- Pathname of the file to which data will be appended; may be relative or absolute, server-dependent -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Telnet end-of-line sequence (CRLF) terminating the command -->
</message>
  <message name="SITE">
    <!-- Command to invoke server-specific, site-dependent services that are not universally defined in FTP protocol -->
    <field name="CommandCode" type="constant" length="4B" value="SITE"/>
    <!-- Four-character command code indicating a site parameter request -->
    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Space character separating command code from argument (present only if an argument follows; if no argument, omit this field and command ends with CRLF) -->
    <field name="Argument" type="variable" length="undefined" value="ASCII code 33–126 (printable) or any ASCII except CR and LF"/>
    <!-- Site-specific command string; content and syntax defined by the server and typically documented in a reply to HELP SITE -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed marking the end of the command line -->
</message>
  <message name="MODE">
    <!-- Command to set the transfer mode for data connections. The argument is a single character specifying Stream, Block, or Compressed mode. Default is Stream. -->

    <field name="CommandCode" type="constant" length="4B" value="MODE"/>
    <!-- FTP command code indicating transfer mode command. Four ASCII characters. Case-insensitive. -->

    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Space character separating command code and argument. Per RFC, one or more spaces are allowed; single space is typical. -->

    <field name="ModeCode" type="variable" length="1B" value="S, B, or C (case-insensitive)"/>
    <!-- Transfer mode specification: S = Stream, B = Block, C = Compressed. ASCII character. Case-insensitive per RFC. -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed indicating end of command line (NVT-ASCII). -->
</message>
  <message name="MIC">
    <!-- Integrity Protected Command (MIC) - used to send an FTP command protected by a message integrity check. The argument is a base64-encoded safe message. -->
    <field name="CommandCode" type="constant" length="3B" value="MIC"/>
    <!-- Command code 'MIC' indicating Integrity Protected Command -->
    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Space character separating command code from argument -->
    <field name="Base64Data" type="variable" length="undefined" value="A-Z a-z 0-9 + / = (base64 alphabet)"/>
    <!-- Base64-encoded protected message; variable length, can be arbitrarily long -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed indicating end of the command line -->
</message>
  <message name="RNTO">
    <!-- Command to specify the new pathname for a file to be renamed, must be immediately preceded by an RNFR command -->
    <field name="CommandCode" type="constant" length="4B" value="RNTO"/>
    <!-- Command code indicating rename-to operation; case-insensitive, usually sent uppercase -->
    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Space character (SP) separating command code from the pathname argument -->
    <field name="Pathname" type="variable" length="undefined" value="ASCII printable characters excluding CR and LF"/>
    <!-- New pathname of the file; variable-length string of ASCII characters (any except 0x0D and 0x0A) -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Telnet end-of-line sequence (Carriage Return followed by Line Feed) terminating the command -->
</message>
  <message name="NOOP">
    <!-- No operation command that does not affect any parameters or previously entered commands; server sends an OK reply -->
    <field name="CommandCode" type="constant" length="4B" value="NOOP"/>
    <!-- Fixed command code for NOOP, four ASCII characters (case-insensitive but typically uppercase) -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Telnet end-of-line sequence: Carriage Return (0x0D) followed by Line Feed (0x0A) -->
</message>
  <message name="REST">
    <!-- Command to set a restart marker for resuming a file transfer. Must be immediately followed by a service command such as RETR or STOR. -->

    <field name="CommandCode" type="constant" length="4B" value="REST"/>
    <!-- Command code indicating the restart command (case-insensitive alphabetic characters). -->

    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Space character (SP) separating the command code from the argument. -->

    <field name="Marker" type="variable" length="undefined" value="printable ASCII (codes 33-126)"/>
    <!-- Marker value representing the point in the data stream from which to restart transfer. In STREAM mode, it must be one or more decimal digits (0-9). According to RFC 959, the argument is a <marker> (printable string). The actual length is variable and terminated by CRLF. -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed indicating the end of the command. For NVT-ASCII control connection. -->
</message>
  <message name="OPTS">
    <!-- FTP OPTS command used to specify desired behavior of a server-FTP process when another FTP command is later issued -->
    <field name="CommandCode" type="constant" length="4B" value="OPTS"/>
    <!-- OPTS command keyword (case-insensitive but traditionally sent uppercase) -->
    <field name="Whitespace1" type="constant" length="1B" value="0x20"/>
    <!-- Space character separating the command code from the command-name -->
    <field name="CommandName" type="variable" length="undefined" value="ASCII printable characters excluding SPACE, CR, LF"/>
    <!-- The name of the FTP command for which options are being set (e.g., MLST, FEAT). This field ends at the next space or CRLF. -->
    <field name="OptionalSpaceAndOptions" type="variable" length="undefined" value="ASCII printable characters excluding CR, LF; if present, first character must be 0x20"/>
    <!-- Optional field containing a leading space and the command-options string. The format of command-options depends on the target command. For OPTS MLST, command-options is a semicolon-separated list of fact names with no internal spaces. If no options are provided, this field is empty (zero length). -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed terminating the command line -->
</message>
  <message name="STOU">
    <!-- Store Unique: instructs the server to accept data via the data connection and store it as a new file with a unique name in the current directory -->

    <field name="CommandCode" type="constant" length="3B" value="STOU"/>
    <!-- Command code for Store Unique. Alphabetic characters, case-insensitive. No argument field is present because the server generates the filename -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Telnet end-of-line sequence: Carriage Return (0x0D) followed by Line Feed (0x0A). Marks the end of the command -->
</message>
  <message name="CWD">
    <!-- Command to change the working directory on the FTP server -->
    <field name="CommandCode" type="constant" length="3B" value="CWD"/>
    <!-- Command code indicating a change of working directory (case-insensitive) -->
    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Space character separating command code and argument; at least one space is required per RFC, but multiple spaces are allowed -->
    <field name="Pathname" type="variable" length="undefined" value="ASCII characters except CR (0x0D) and LF (0x0A)"/>
    <!-- Directory path to set as the current working directory; may be a relative or absolute pathname -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed indicating end of the command -->
</message>
  <message name="RETR">
    <!-- Retrieve (RETR) command: requests the server to transfer a copy of a file specified by the pathname -->
    <field name="CommandCode" type="constant" length="3B" value="RETR"/>
    <!-- Command code indicating the RETRIEVE (RETR) request. Case-insensitive per RFC 959, but transmitted as uppercase by convention -->
    <field name="Separator" type="constant" length="1B" value="0x20"/>
    <!-- Single space character (ASCII 0x20) separating the command code from the pathname argument -->
    <field name="Pathname" type="variable" length="undefined" value="ASCII printable characters (codes 33–126), no CR or LF"/>
    <!-- Pathname of the file to be retrieved. The syntax follows server site conventions; terminated by the end-of-line sequence -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Telnet end-of-line sequence: Carriage Return (0x0D) followed by Line Feed (0x0A) indicating the end of the command line -->
</message>
  <message name="TYPE">
    <!-- Command to set the representation type for data transfer (ASCII, EBCDIC, Image, or Local byte size) -->
    <field name="CommandCode" type="constant" length="4B" value="TYPE"/>
    <!-- Command code identifying this as a TYPE command; case-insensitive but typically uppercase -->
    <field name="Separator" type="constant" length="1B" value="0x20"/>
    <!-- Space (ASCII 32) separating the command code from the argument -->
    <field name="TypeCode" type="variable" length="undefined" value="One of: 'A' (with optional SP and format char N/T/C), 'E' (same), 'I', or 'L' followed by SP and a decimal integer byte-size (1-255)"/>
    <!-- Representation type argument: first character selects type; for ASCII/EBCDIC an optional format specifier; for Local byte a mandatory byte size integer; all characters ASCII, case-insensitive -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed (CRLF) terminating the command line -->
</message>
  <message name="LIST">
  <!-- Command to request a directory listing from the FTP server; sends a list of files in the specified directory (or current directory if no pathname given) over the data connection -->

  <field name="CommandCode" type="constant" length="4B" value="LIST"/>
  <!-- Command code for LIST request, transmitted in uppercase (case-insensitive) -->

  <field name="Whitespace" type="constant" length="1B" value="0x20"/>
  <!-- Space character separating command code from the optional pathname argument; present only if a pathname follows -->

  <field name="Pathname" type="variable" length="undefined" value="ASCII codes 0-127 except CR (0x0D) and LF (0x0A)"/>
  <!-- Optional pathname (directory or file) for which to list information; if omitted, the current working directory is implied. The pathname may include spaces, but leading spaces are not allowed as the first space is the separator. -->

  <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
  <!-- Carriage Return and Line Feed (CRLF) terminating the command, per Telnet NVT conventions -->
</message>
  <message name="EPRT">
    <!-- Extended PORT command for specifying an extended address for the data connection, supporting IPv4, IPv6, and other network protocols -->

    <field name="CommandCode" type="constant" length="4B" value="EPRT"/>
    <!-- Command keyword that identifies the command as EPRT -->

    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Single space (ASCII 32) separating the command keyword from the following delimiter -->

    <field name="Delimiter1" type="variable" length="1B" value="ASCII code 33-126"/>
    <!-- First delimiter character; must be a printable ASCII character (33-126); recommended "|" (124); identical to all subsequent delimiters in this command -->

    <field name="NetProtocol" type="variable" length="undefined" value="decimal integer string (1..65535)"/>
    <!-- Address family number (e.g., 1 for IPv4, 2 for IPv6) as defined by IANA; encoded as decimal digits -->

    <field name="Delimiter2" type="variable" length="1B" value="ASCII code 33-126"/>
    <!-- Second delimiter character, must match Delimiter1 -->

    <field name="NetworkAddress" type="variable" length="undefined" value="ASCII string in protocol-specific format"/>
    <!-- Network address representation: for IPv4 dotted-decimal (e.g., 132.235.1.2), for IPv6 as per RFC 2373 (e.g., 1080::8:800:200C:417A) -->

    <field name="Delimiter3" type="variable" length="1B" value="ASCII code 33-126"/>
    <!-- Third delimiter character, must match Delimiter1 -->

    <field name="TCPPort" type="variable" length="undefined" value="decimal integer string (0..65535)"/>
    <!-- TCP port number on which the server should open a data connection; encoded as decimal digits -->

    <field name="Delimiter4" type="variable" length="1B" value="ASCII code 33-126"/>
    <!-- Fourth and final delimiter character, must match Delimiter1; closes the argument field -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed (CRLF) terminating the command line, as per FTP telnet control protocol -->
</message>
  <message name="RNFR">
    <!-- RENAME FROM command: specifies the old pathname of the file to be renamed; must be immediately followed by a RENAME TO (RNTO) command -->
    <field name="CommandCode" type="constant" length="4B" value="RNFR"/>
    <!-- Command code for RENAME FROM, encoded in NVT-ASCII (case-insensitive, typically uppercase) -->
    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Space (0x20) separating the command code from the argument; one or more spaces are allowed per RFC, but we model a single space for consistency -->
    <field name="Pathname" type="variable" length="undefined" value="ASCII printable characters (33-126) and other ASCII except CR and LF"/>
    <!-- Old pathname of the file to be renamed; a string of any ASCII characters except CR (0x0D) and LF (0x0A); length varies and is terminated by the end-of-line sequence -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return (0x0D) and Line Feed (0x0A) marking the end of the command line, per Telnet NVT conventions -->
</message>
  <message name="RMD">
    <!-- Command to remove a directory on the FTP server -->

    <field name="CommandCode" type="constant" length="3B" value="RMD"/>
    <!-- Command code indicating the remove directory request -->

    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Space character separating command code from the pathname argument -->

    <field name="Pathname" type="variable" length="undefined" value="ASCII excluding CR, LF"/>
    <!-- Pathname of the directory to be removed; can be absolute or relative; must not contain carriage return or line feed characters -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed indicating the end of the command line -->
</message>
  <message name="DELE">
  <!-- Command to delete a file on the FTP server; causes the file specified by the pathname to be removed at the server site -->
  <field name="CommandCode" type="constant" length="4B" value="DELE"/>
  <!-- Command code (four alphabetic characters) identifying the delete request; case-insensitive, typically sent as uppercase -->
  <field name="Whitespace" type="constant" length="1B" value="0x20"/>
  <!-- Space character (ASCII 0x20) separating the command code from the pathname argument -->
  <field name="Pathname" type="variable" length="undefined" value="ASCII codes 32-126 excluding CR (0x0D) and LF (0x0A)"/>
  <!-- Pathname of the file to be deleted; variable-length string of printable ASCII characters (and possibly other ASCII except CR/LF); length determined by the following terminator -->
  <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
  <!-- Telnet end-of-line sequence: Carriage Return (CR) followed by Line Feed (LF); marks the termination of the command line -->
</message>
  <message name="REIN">
    <!-- Reinitialize command: terminates current user session, flushes I/O and account information, resets all parameters to defaults, and leaves control connection open. Any transfer in progress is allowed to complete. No argument is expected. -->

    <field name="CommandCode" type="constant" length="4B" value="REIN"/>
    <!-- Command code for REINITIALIZE. Alphabetic characters, case-insensitive. Typically transmitted as uppercase. -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return (CR) and Line Feed (LF) marking the end of the command. -->
</message>
  <message name="PBSZ">
    <!-- Protection Buffer Size command used to negotiate the maximum size of encoded data blocks for file transfer. Must be issued after successful security data exchange and before PROT command. -->

    <field name="CommandCode" type="constant" length="4B" value="PBSZ"/>
    <!-- Command code indicating protection buffer size negotiation. Case-insensitive ASCII characters. -->

    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Space character separating command code and argument. -->

    <field name="BufferSize" type="variable" length="undefined" value="ASCII decimal digits (1-4294967295)"/>
    <!-- Decimal integer representing the maximum protected buffer size in bytes, from 1 to (2^32)-1. The length is variable as a string of ASCII digits, terminated by CRLF. -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed indicating end of the command (NVT-ASCII line termination). -->
</message>
  <message name="CCC">
    <!-- Command to clear command channel, disabling integrity protection on subsequent commands and replies (RFC 2228) -->
    <field name="CommandCode" type="constant" length="3B" value="CCC"/>
    <!-- Command code indicating clear command channel, case-insensitive but typically uppercase -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed indicating end of the command line -->
</message>
  <message name="HELP">
    <!-- Request for server to send helpful information about implementation status; optional argument specifies a command name for specific help -->
    <field name="CommandCode" type="constant" length="4B" value="HELP"/>
    <!-- Command code indicating HELP request, case-insensitive but transmitted in uppercase typical -->
    <field name="Whitespace" type="variable" length="undefined" value="0x20"/>
    <!-- One or more space characters separating command code and argument; present only if argument is provided -->
    <field name="Argument" type="variable" length="undefined" value="ASCII characters except CR, LF"/>
    <!-- Optional argument specifying a command name or subject for which help is requested -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed indicating end of command (Telnet end-of-line) -->
</message>
  <message name="CONF">
    <!-- Confidentiality protected command: sends a base64 encoded confidential message as an FTP command -->

    <field name="CommandCode" type="constant" length="4B" value="CONF"/>
    <!-- Command code for Confidential Protected Command, case-insensitive but typically uppercase -->

    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Space separating command code from argument -->

    <field name="Base64Data" type="variable" length="undefined" value="Printable ASCII characters from base64 alphabet: A-Z, a-z, 0-9, +, /, = for padding"/>
    <!-- Base64 encoded confidential message; length is variable and depends on the encoded data; must be a single line without internal CR/LF; may be arbitrarily long -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed terminating the command line -->
</message>
  <message name="ADAT">
    <!-- Authentication/Security Data command used in FTP security extensions (RFC 2228) to exchange security mechanism specific data between client and server -->
    <field name="CommandCode" type="constant" length="4B" value="ADAT"/>
    <!-- Command code indicating the Authentication/Security Data command; case-insensitive per FTP specification -->
    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Space character separating command code from argument -->
    <field name="SecurityData" type="variable" length="undefined" value="Base64 encoded security data (characters: A-Z, a-z, 0-9, +, /, =)"/>
    <!-- Variable-length base64 encoded security data specific to the security mechanism previously negotiated via the AUTH command; may be arbitrarily long and must not include line breaks -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed indicating end of the command -->
</message>
</ir>
