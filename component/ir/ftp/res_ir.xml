<?xml version='1.0' encoding='UTF-8' standalone='yes'?>
<ir>
  <message name="FTPResponse">
    <!-- Reply from FTP server to a command; consists of a three-digit status code, a separator, text content, and end-of-line. -->
    <field name="StatusCode" type="variable" length="3B" value="100-599"/>
    <!-- Three-digit reply code. First digit: 1=preliminary, 2=completion, 3=intermediate, 4=transient negative, 5=permanent negative. Second digit indicates function group (syntax, info, connections, auth, file system). Third digit gives finer detail. -->
    <field name="Separator" type="constant" length="1B" value="0x20 or 0x2D"/>
    <!-- Space (0x20) for single-line replies; hyphen (0x2D) for the first line of multi-line replies. -->
    <field name="Text" type="variable" length="undefined" value="TCHAR (VCHAR, SP, HTAB) - printable ASCII plus whitespace"/>
    <!-- Human-readable message text. For multi-line replies, additional text lines (each terminated by CRLF) follow this first line; the last line repeats the same StatusCode followed by a space and optional text. -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Telnet end-of-line: carriage return (0x0D) followed by line feed (0x0A). -->
</message>
</ir>
