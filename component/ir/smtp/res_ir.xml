<?xml version='1.0' encoding='UTF-8' standalone='yes'?>
<ir>
  <message name="response message of smtp protocol">
  <!-- A multi-line reply is one or more repetitions of the code/separator/text/CRLF pattern; '-' separates continuation lines and SP precedes the final text. -->
  <field name="reply-code" type="variable" length="3B" value="[0-9]{3}"/>
  <!-- Three-digit numeric completion code. -->
  <field name="separator" type="variable" length="undefined" value="[ -]?"/>
  <!-- Optional single-byte separator: SP before text, '-' for continuation; absent when no text follows. -->
  <field name="text" type="variable" length="undefined" value="[ -~]*"/>
  <!-- Optional free-form ASCII text, excluding CR/LF; must be empty when separator is absent. -->
  <field name="crlf" type="constant" length="2B" value="&#13;&#10;"/>
  <!-- CRLF terminates every SMTP line. -->
</message>
</ir>
