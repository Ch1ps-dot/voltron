<?xml version='1.0' encoding='UTF-8' standalone='yes'?>
<ir>
  <message name="MAIL">
    <!-- The MAIL command initiates a mail transaction, providing the sender (reverse-path) and optional parameters. -->
    <field name="CommandLiteral" type="constant" length="10B" value="MAIL FROM:"/>
    <!-- Literal "MAIL FROM:" (case-insensitive but typically uppercase). Includes the colon. -->
    <field name="ReversePath" type="variable" length="undefined" value="Path | &lt;&gt;"/>
    <!-- Reverse-path: a mailbox enclosed in angle brackets (e.g., <user@domain>) or the null reverse-path "<>". Maximum total length 256 octets including brackets. -->
    <field name="OptionalSpace" type="constant" length="1B" value="0x20" optional="true"/>
    <!-- Space character present only if mail-parameters follow; omitted otherwise. -->
    <field name="MailParameters" type="variable" length="undefined" value="esmtp-param *(SP esmtp-param)" optional="true"/>
    <!-- Optional ESMTP parameters (e.g., BODY=8BITMIME, SIZE=12345). Each parameter is a keyword optionally followed by "=" and a value. Multiple parameters are space-separated. -->
    <field name="CRLF" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed terminating the command line. -->
</message>
  <message name="HELO">
    <!-- Command to identify the SMTP client to the SMTP server; used to initiate an SMTP session. -->
    <field name="CommandCode" type="constant" length="4B" value="HELO"/>
    <!-- Command verb indicating the HELO command; always in uppercase or mixed case (case-insensitive). -->
    <field name="Space" type="constant" length="1B" value="0x20"/>
    <!-- Space character (SP) separating the command verb from the domain argument. -->
    <field name="Domain" type="variable" length="undefined" value="ALPHA/DIGIT/HYPHEN/DOT (ASCII printable characters excluding CR/LF)"/>
    <!-- Fully-qualified domain name of the SMTP client; conforms to Domain syntax: sub-domain *('.' sub-domain). Must be resolvable FQDN. Per RFC, HELO does not allow address-literal (unlike EHLO). -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return (CR) and Line Feed (LF) terminating the command line. -->
</message>
  <message name="DATA">
    <!-- Command to initiate the transfer of mail content -->
    <!-- The SMTP client sends "DATA<CRLF>" to begin the mail transaction. The server responds with 354, after which the client sends the mail data lines, terminated by "<CRLF>.<CRLF>". -->

    <field name="Command" type="constant" length="4B" value="DATA"/>
    <!-- ASCII characters "DATA" - the command verb indicating that mail data follows -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return (0x0D) followed by Line Feed (0x0A) terminating the command line -->
</message>
  <message name="EHLO">
    <!-- Extended HELLO command used by an SMTP client to identify itself to the server and request service extensions support -->

    <field name="CommandKeyword" type="constant" length="4B" value="EHLO"/>
    <!-- Command verb indicating the Extended HELLO (EHLO) operation; case-insensitive but conventionally uppercase -->

    <field name="Separator" type="constant" length="1B" value="0x20"/>
    <!-- Space character (ASCII 32) separating the command verb from the argument -->

    <field name="ClientIdentity" type="variable" length="undefined" value="ASCII letters, digits, hyphens, dots (domain) OR '[' followed by IP address literal and ']'"/>
    <!-- Fully-qualified domain name (FQDN) of the SMTP client, or an address literal enclosed in square brackets (e.g., [IPv4:...] or [IPv6:...]); must not include CR or LF -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return (0x0D) followed by Line Feed (0x0A) marking the end of the command line -->
</message>
  <message name="NOOP">
    <!-- No-operation command, used to test connectivity without affecting server state. Server responds with 250 OK. -->
    <field name="CommandVerb" type="constant" length="4B" value="NOOP"/>
    <!-- The command verb "NOOP" (case-insensitive, typically uppercase). Indicates a no-operation request. -->
    <field name="Space" type="constant" length="1B" value="0x20"/>
    <!-- Optional space character (0x20). Present only if a parameter string follows. Servers SHOULD ignore any parameter. -->
    <field name="Parameter" type="variable" length="undefined" value="ASCII printable characters (excluding CR and LF)"/>
    <!-- Optional parameter string. Per RFC 5321, servers SHOULD ignore it. Length depends on implementation; no defined limit. -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return (0x0D) followed by Line Feed (0x0A), marking end of the command line. -->
</message>
  <message name="QUIT">
    <!-- Command to terminate an SMTP session. The server replies with 221 OK and closes the transmission channel. -->

    <field name="CommandCode" type="constant" length="3B" value="QUIT"/>
    <!-- The command verb "QUIT" (ASCII characters Q, U, I, T). No arguments follow this command. -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return (CR, 0x0D) and Line Feed (LF, 0x0A) indicating the end of the command line. -->
</message>
  <message name="RSET">
    <!-- RSET (RESET) command: aborts the current mail transaction and clears all buffers and state tables. The receiver must reply with "250 OK". No arguments are permitted. -->

    <field name="CommandVerb" type="constant" length="3B" value="RSET"/>
    <!-- The command verb "RSET" in uppercase ASCII (case-insensitive per SMTP spec). Indicates the reset command. -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- CRLF line terminator: ASCII carriage return (0x0D) followed by line feed (0x0A). Marks the end of the command line. -->
</message>
  <message name="VRFY">
    <!-- Verify a user name or mailbox existence; requests confirmation that the argument identifies a user or mailbox. -->

    <field name="CommandCode" type="constant" length="3B" value="VRFY"/>
    <!-- Command verb indicating a VRFY request; case-insensitive, but typically sent in uppercase. -->

    <field name="Whitespace" type="constant" length="1B" value="0x20"/>
    <!-- Space (SP) character separating command verb from the argument string. -->

    <field name="String" type="variable" length="undefined" value="ASCII printable characters (excluding control chars); may be an Atom or Quoted-string as per RFC 5321 Section 4.1.2"/>
    <!-- The user name, mailbox name, or local-part@domain string to be verified. The string may include quoted forms and backslash-escaped characters. No length limit defined by this command, though server-imposed limits may apply. -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return (0x0D) followed by Line Feed (0x0A) terminating the command line. -->
</message>
  <message name="HELP">
    <!-- Command to request help information from the SMTP server -->
    <field name="Command" type="constant" length="3B" value="HELP"/>
    <!-- Command verb indicating the HELP command -->
    <field name="OptionalArgument" type="variable" length="undefined" value="0x20 (space) followed by ASCII printable characters, excluding CR and LF"/>
    <!-- Optional argument: a space character followed by a topic string (e.g., a command name). Present only if the client wishes to request specific help. -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return and Line Feed indicating the end of the command line -->
</message>
  <message name="EXPN">
    <!-- EXPN (EXpand) command: asks the receiver to confirm that the argument identifies a mailing list and to return its membership. -->

    <field name="CommandVerb" type="constant" length="3B" value="EXPN"/>
    <!-- The command verb indicating the EXPN operation. Case-insensitive but conventionally uppercase. -->

    <field name="Separator" type="constant" length="1B" value="0x20"/>
    <!-- Space (SP) character separating the command verb from its argument. -->

    <field name="MailingListIdentifier" type="variable" length="undefined" value="Atom (1*atext) or Quoted-string (DQUOTE *QcontentSMTP DQUOTE); allowed characters: ASCII letters, digits, and punctuation as per RFC 5321 section 4.1.2."/>
    <!-- The argument identifying the mailing list. It may be a simple string (Atom) or a quoted string containing spaces or special characters. The actual value is case-sensitive per SMTP semantics. -->

    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- CRLF sequence terminating the command line. -->
</message>
  <message name="RCPT">
    <!-- SMTP RECIPIENT command: identifies a single recipient for the mail data. Multiple RCPT commands may be issued for multiple recipients. -->
    <field name="CommandVerb" type="constant" length="4B" value="RCPT"/>
    <!-- Command verb (uppercase) indicating the RCPT command. Case-insensitive per SMTP spec. -->
    <field name="Space" type="constant" length="1B" value="0x20"/>
    <!-- Space (ASCII 0x20) separating command verb from the next argument. -->
    <field name="ToIndicator" type="constant" length="3B" value="TO:"/>
    <!-- Literal string "TO:" (case-insensitive) introducing the forward-path. No space after colon. -->
    <field name="ForwardPath" type="variable" length="undefined" value="string starting with '&lt;', optionally containing source route and colon, then a mailbox, and ending with '&gt;'; composed of ASCII graphics (32-126) except control chars and bare CR/LF; max total length 256 octets including punctuation."/>
    <!-- The forward-path argument, always enclosed in angle brackets. Must be a valid Path (Mailbox with optional source route). Special case: may be '&lt;Postmaster&gt;' (without domain) or '&lt;Postmaster@Domain&gt;'. Use of source routes is deprecated. -->
    <field name="RcptParameters" type="variable" length="undefined" value="optional: a SP (0x20) followed by one or more ESMTP parameters, each of form keyword[=value]; keyword: ALPHA/DIGIT and '-' ; value: any ASCII printable (33-126) except '=' and SP; cannot contain control characters."/>
    <!-- Optional ESMTP service extension parameters. If present, preceded by a single space. Omitted entirely if no parameters. -->
    <field name="EndOfLine" type="constant" length="2B" value="0x0D0A"/>
    <!-- Carriage Return (0x0D) and Line Feed (0x0A) terminating the command line. -->
</message>
</ir>
