<?xml version='1.0' encoding='UTF-8' standalone='yes'?>
<ir>
  <message name="MAIL" direction="request" protocol="smtp">
  <field name="Verb" type="constant" length="undefined" value="MAIL">
    <!-- SMTP command verb "MAIL"; not case-sensitive (RFC 5321 section 2.4). -->
  </field>
  <field name="Space" type="constant" length="undefined" value=" ">
    <!-- Single SP character separating the verb from the FROM keyword. -->
  </field>
  <field name="FromKeyword" type="constant" length="undefined" value="FROM:">
    <!-- Fixed keyword introducing the sender reverse-path; not case-sensitive. -->
  </field>
  <field name="ReversePath" type="variable" length="undefined" value="&lt;[A-d-l:]Mailbox&gt; | &lt;&gt;">
    <!-- Sender reverse-path (RFC 5321 section 4.1.1.2). Angle brackets are
         wire delimiters; optional A-d-l source route is deprecated.
         Mailbox local-part is case-sensitive; domain is case-insensitive
         (RFC 5321 section 2.4).  "<>" is the null reverse-path. -->
  </field>
  <field name="MailParameters" type="variable" length="undefined" value="[SP mail-parameter *(SP mail-parameter)]">
    <!-- Optional extension parameters (RFC 5321 section 4.1.1.2).
         Each mail-parameter is a registered tag "=" value pair, e.g.,
         BODY=BINARYMIME (RFC 3030), AUTH=... (RFC 4954).  PIPELINING
         adds no MAIL parameters (RFC 2920). -->
  </field>
  <field name="CRLF" type="constant" length="undefined" value="&#13;&#10;">
    <!-- Line terminator: ASCII CR (0x0D) immediately followed by LF (0x0A)
         (RFC 5321 section 2.3.8). -->
  </field>
</message>
  <message name="DATA">
  <field name="verb" type="constant" length="B" value="DATA"/>
  <!-- Command verb: SMTP commands are alphabetic, and the DATA command takes no argument clause, so it is sent as the canonical uppercase verb "DATA". -->
  <field name="crlf" type="constant" length="B" value="&#13;&#10;"/>
  <!-- Line terminator: SMTP lines must be terminated by CR immediately followed by LF; no bare CR or LF is permitted on the wire. -->
</message>
  <message name="ETRN">
  <!-- Direction: request. SMTP client sends this ETRN command to the server. -->
  <field name="command-verb" type="constant" length="4B" value="ETRN"/>
  <!-- SMTP command verb. ASCII letters; case-insensitive, but uppercase is the conventional wire form. -->
  <field name="space" type="constant" length="1B" value=" "/>
  <!-- Required SP delimiter because ETRN has an argument following the verb. -->
  <field name="option-character" type="variable" length="undefined" value="[ '@' / '#' ]"/>
  <!-- Optional option character: omitted for ordinary node processing; '@' releases subdomain mail; '#' selects a named local queue. Zero or one byte. -->
  <field name="node-name" type="variable" length="undefined" value="&lt;node name&gt;"/>
  <!-- Node name: fully qualified domain name, or local queue name with '#'. ASCII; domain portion is case-insensitive. -->
  <field name="line-ending" type="constant" length="2B" value="&#13;&#10;"/>
  <!-- CRLF line ending: ASCII CR 0x0D followed by LF 0x0A, required by SMTP for every command line. -->
</message>
  <message name="SAML">
  <field name="command" type="constant" length="4" value="SAML" note="SMTP command verb “SAML”; case-insensitive, shown in canonical uppercase."/>
  <field name="space" type="constant" length="1" value=" " note="Required &lt;SP&gt; separator between the command verb and the argument clause."/>
  <field name="from_keyword" type="constant" length="5" value="FROM:" note="Fixed keyword introducing the reverse-path; case-insensitive per SMTP syntax."/>
  <field name="reverse_path" type="variable" length="variable" value="Reverse-path" note="Variable SMTP Reverse-path, including angle brackets and optional source route; maximum 256 octets."/>
  <field name="crlf" type="constant" length="2" value="&#13;&#10;" note="Mandatory SMTP line terminator; commands are transmitted as lines ending in CRLF."/>
</message>
  <message name="RCPT">
  <field name="command-verb" type="constant" length="B" value="RCPT"/>
  <!-- Fixed SMTP command verb; the verb token is case-insensitive. -->
  <field name="separator" type="constant" length="B" value=" "/>
  <!-- Required single SP between the verb and the TO: argument. -->
  <field name="to-marker" type="constant" length="B" value="TO:"/>
  <!-- Fixed case-insensitive RCPT argument marker. -->
  <field name="forward-path" type="variable" length="undefined" value="( &quot;&lt;Postmaster&gt;&quot; / &quot;&lt;&quot; [ A-d-l &quot;:&quot; ] Mailbox &quot;&gt;&quot; )"/>
  <!-- Recipient forward-path; angle brackets are on the wire. A-d-l is an optional source route; mailbox local-part is case-sensitive. -->
  <field name="rcpt-parameters" type="variable" length="undefined" value="[ 1*( SP esmtp-keyword [ &quot;=&quot; esmtp-value ] ) ]"/>
  <!-- Optional ESMTP RCPT extension parameter list; absent if no extension parameters follow the path. -->
  <field name="line-ending" type="constant" length="B" value="&#13;&#10;"/>
  <!-- Mandatory CRLF command-line terminator. -->
</message>
  <message name="BDAT">
  <field name="command" type="constant" length="B" value="BDAT"/>
  <!-- SMTP command verb; case-insensitive per RFC 5321, canonical wire form is uppercase. -->
  <field name="SP" type="constant" length="B" value=" "/>
  <!-- Required space between the BDAT verb and its first argument. -->
  <field name="chunk-size" type="variable" length="undefined" value="1*DIGIT"/>
  <!-- Decimal octet count of the chunk data that follows the command line; 0 is permitted. -->
  <field name="last-marker" type="variable" length="undefined" value="[ SP 'LAST' ]"/>
  <!-- ABNF optional group; present as the literal bytes " LAST" on the final chunk, otherwise absent. -->
  <field name="CRLF" type="constant" length="B" value="&#13;&#10;"/>
  <!-- Required SMTP line terminator; not counted in chunk-size. -->
</message>
  <message name="RSET">
    <field name="command_verb" type="constant" length="B" value="RSET"/><!-- SMTP command verb: RFC 5321 ABNF literal "RSET" is case-insensitive; uppercase is shown as the canonical form. RSET takes no arguments, so no SP or argument clause is transmitted. -->
    <field name="crlf" type="constant" length="B" value="&#13;&#10;"/><!-- <CRLF> line terminator: ASCII CR (0x0D) immediately followed by ASCII LF (0x0A), as required by RFC 5321 Sections 2.3.8 and 4.1.1. -->
</message>
  <message name="EHLO" direction="request">
  <field name="verb" type="constant" length="B" value="EHLO"/>
  <!-- EHLO command verb; RFC 5321 §2.4 permits case variations, but canonical uppercase is shown. -->
  <field name="SP" type="constant" length="B" value=" "/>
  <!-- Required single ASCII space separator between verb and argument (§2.4). -->
  <field name="client-domain" type="variable" length="undefined" value="Domain / address-literal"/>
  <!-- EHLO argument: client-supplied domain name or address literal; variable ASCII token. -->
  <field name="CRLF" type="constant" length="B" value="&#13;&#10;"/>
  <!-- SMTP command lines end with CR immediately followed by LF (§2.3.8). -->
</message>
  <message name="HELP">
  <field name="verb" type="constant" length="4B" value="HELP">
    <!-- SMTP command verb; ASCII "HELP". The grammar is case-insensitive, but the canonical/uppercase form is shown. -->
  </field>
  <field name="argument" type="variable" length="undefined" value="[ SP String ]">
    <!-- Optional HELP topic. This field contributes no bytes when omitted. When present, it begins with one ASCII SP and is followed by a String containing no CR or LF; the total command line, including "HELP" and <CRLF>, MUST NOT exceed 512 octets. -->
  </field>
  <field name="line-terminator" type="constant" length="2B" value="&#13;&#10;">
    <!-- SMTP <CRLF> line terminator: ASCII CR (0x0D) immediately followed by ASCII LF (0x0A). -->
  </field>
</message>
  <message name="HELO">
    <field name="verb" type="constant" length="B" value="HELO"/><!-- SMTP command verb; case-insensitive per RFC 5321 Section 2.4. -->
    <field name="SP" type="constant" length="B" value=" "/><!-- Single ASCII space separator (0x20) between verb and Domain. -->
    <field name="Domain" type="variable" length="undefined" value="Domain"/><!-- HELO argument; Domain per RFC 5321 Section 4.1.2; US-ASCII; variable length; total command line including CRLF is at most 512 octets. -->
    <field name="CRLF" type="constant" length="B" value="&#13;&#10;"/><!-- Line terminator; ASCII CR (0x0D) followed immediately by LF (0x0A). -->
</message>
  <message name="TURN">
  <field name="verb" type="constant" length="4B" value="TURN"/>
  <!-- SMTP command verbs are case-insensitive; uppercase is shown. TURN takes no arguments, so no SP/argument field is present. -->
  <field name="crlf" type="constant" length="2B" value="&#13;&#10;"/>
  <!-- Required SMTP line terminator: CR (0x0D) immediately followed by LF (0x0A). -->
</message>
  <message name="STARTTLS">
  <field name="verb" type="constant" length="B" value="STARTTLS"/>
  <!-- SMTP command verb; the STARTTLS extension defines this verb with no parameters. SMTP verbs are US-ASCII and case-insensitive; uppercase is the canonical wire form. -->
  <field name="crlf" type="constant" length="B" value="&#13;&#10;"/>
  <!-- Required command-line framing: ASCII CR (0x0D) immediately followed by ASCII LF (0x0A). No argument or SP is present. -->
</message>
  <message name="VRFY">
    <field name="verb" type="constant" length="B" value="VRFY"/>
    <!-- SMTP command verb; uppercase is canonical, but the ABNF verb is case-insensitive per RFC 5321 Sections 2.4 and 4.1.1. -->
    <field name="SP" type="constant" length="B" value=" "/>
    <!-- Required single ASCII space separating the VRFY verb from its argument. -->
    <field name="String" type="variable" length="undefined" value="user-name [@domain]"/>
    <!-- VRFY argument: a user name or a user name and domain, in US-ASCII. If it contains a mailbox local-part, that local-part is case-sensitive. The argument must not contain bare CR/LF; the whole command line is limited to 512 octets including verb and CRLF. -->
    <field name="CRLF" type="constant" length="B" value="&#13;&#10;"/>
    <!-- Required SMTP line terminator: ASCII CR (0x0D) immediately followed by ASCII LF (0x0A). -->
</message>
  <message name="SEND">
  <field name="command" type="constant" length="B" value="SEND"/>
  <!-- SMTP command verb; 4 ASCII octets. Case-insensitive per spec, shown in canonical uppercase. -->
  <field name="separator" type="constant" length="B" value=" "/>
  <!-- Required SP separator between the command verb and its argument clause. -->
  <field name="from_keyword" type="constant" length="B" value="FROM:"/>
  <!-- Fixed reverse-path introducer; case-insensitive; directly precedes the reverse-path with no space. -->
  <field name="reverse_path" type="variable" length="undefined" value="Path / &lt;&gt;"/>
  <!-- Reverse-path argument: Path or null reverse-path. Maximum 256 octets including punctuation and element separators; mailbox local-part is case-sensitive. -->
  <field name="line_ending" type="constant" length="B" value="&#13;&#10;"/>
  <!-- Required CRLF line terminator; the complete command line including this CRLF is limited to 512 octets. -->
</message>
  <message name="EXPN">
  <field name="verb" type="constant" length="B" value="EXPN"/>
  <!-- Command verb; the ABNF form is case-insensitive, so this is the canonical wire form (Sections 2.4, 4.1.1). -->
  <field name="SP" type="constant" length="B" value=" "/>
  <!-- Required single ASCII SP separating verb from argument because EXPN takes a string parameter. -->
  <field name="string" type="variable" length="undefined" value="String"/>
  <!-- Mailing-list/alias name to expand; non-empty String, ends before CRLF; complete command line max 512 octets. -->
  <field name="CRLF" type="constant" length="B" value="&#13;&#10;"/>
  <!-- Line terminator: ASCII CR (0x0D) immediately followed by LF (0x0A); no other terminator is valid. -->
</message>
  <message name="NOOP">
  <field name="verb" type="constant" length="B" value="NOOP"/>
  <!-- Fixed command verb from NOOP ABNF; ASCII "NOOP" (4 bytes, 0x4E4F4F50), case-insensitive per RFC 5321 Section 2.4. -->
  <field name="parameter" type="variable" length="undefined" value="[ SP String ]"/>
  <!-- Optional argument; if present, wire bytes are SP (0x20) followed by String. Servers SHOULD ignore it per RFC 5321 Section 4.1.1.9. -->
  <field name="crlf" type="constant" length="B" value="0x0D0A"/>
  <!-- Required line terminator: CR (0x0D) immediately followed by LF (0x0A), per RFC 5321 Sections 2.3.8 and 4.1.1. -->
</message>
  <message name="SOML">
  <field name="command" type="constant" length="B" value="SOML"/>
  <!-- SMTP command verb "SOML" (Send Or Mail), client-to-server request. Canonical uppercase; verbs are case-insensitive per RFC 5321. On the wire: 4 US-ASCII octets. -->
  <field name="SP" type="constant" length="B" value=" "/>
  <!-- One ASCII space (0x20) separating the command verb from its argument clause; required because SOML takes an argument. -->
  <field name="from_keyword" type="constant" length="B" value="FROM:"/>
  <!-- "FROM:" introduces the reverse-path argument. Argument keywords are case-insensitive; shown canonical uppercase. 5 ASCII octets including the colon; the reverse-path follows immediately with no space. -->
  <field name="reverse_path" type="variable" length="undefined" value="reverse-path"/>
  <!-- Required reverse-path argument for the SEND/SOML/SAML command family. Wire form is an SMTP Path: "<" [ A-d-l ":" ] Mailbox ">" or "<>" for a null reverse-path. Max 256 octets including punctuation/element separators; local-part max 64 octets and is case-sensitive. -->
  <field name="CRLF" type="constant" length="B" value="&#13;&#10;"/>
  <!-- SMTP line terminator: ASCII CR (0x0D) immediately followed by ASCII LF (0x0A); 2 octets. Total SOML command line, including this CRLF, must not exceed 512 octets. -->
</message>
  <message name="AUTH">
  <field name="command" type="constant" length="B" value="AUTH"/>
  <!-- SMTP command verb for SASL authentication. Command verbs are case-insensitive; canonical uppercase AUTH is shown. -->
  <field name="SP" type="constant" length="B" value=" "/>
  <!-- Required space after the verb because AUTH takes arguments. -->
  <field name="sasl-mechanism" type="variable" length="undefined" value="1*20(ALPHA / DIGIT / '-' / '_')"/>
  <!-- SASL mechanism name (1-20 ASCII letters, digits, hyphen, or underscore). -->
  <field name="initial-response" type="variable" length="undefined" value="[SP] (base64-string / '=')"/>
  <!-- Optional SASL initial response. The leading SP is transmitted only when this optional element is present; "=" denotes an empty response. -->
  <field name="CRLF" type="constant" length="B" value="&#13;&#10;"/>
  <!-- End-of-line terminator; ASCII CR (0x0D) followed by LF (0x0A). The entire command line must not exceed 512 octets unless an extension raises the limit. -->
</message>
  <message name="QUIT">
  <field name="verb" type="constant" length="B" value="QUIT"/>
  <!-- SMTP command verb "QUIT": ASCII 0x51 0x55 0x49 0x54. QUIT takes no arguments, so the command line contains only this verb. Per RFC 5321 §2.4 the verb token is case-insensitive; this is the canonical uppercase form. -->
  <field name="line-ending" type="constant" length="B" value="&#13;&#10;"/>
  <!-- Mandatory SMTP line terminator: ASCII CR (0x0D) immediately followed by LF (0x0A), per RFC 5321 §2.3.8. It terminates the QUIT command line and is the last byte sequence of the request. -->
</message>
</ir>
